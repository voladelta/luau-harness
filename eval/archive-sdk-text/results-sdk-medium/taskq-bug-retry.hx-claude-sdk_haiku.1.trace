from .jobs import Job
from .retry import backoff, should_retry


class JobQueue:
    def __init__(self, clock):
        self.clock = clock
        self.jobs = {}
        self._n = 0

    def enqueue(self, name, payload=None, priority=0, delay=0.0, max_attempts=3):
        self._n += 1
        job = Job(f"job-{self._n}", name, payload or {}, priority, 0, max_attempts, self.clock.now() + delay)
        self.jobs[job.id] = job
        return job

    def pop_ready(self):
        """Highest priority first, then earliest run_at, then creation order. Counts an attempt."""
        now = self.clock.now()
        ready = [j for j in self.jobs.values() if j.status == "queued" and j.run_at <= now]
        if not ready:
            return None
        job = min(ready, key=lambda j: (-j.priority, j.run_at, int(j.id.split("-")[1])))
        job.status = "running"
        job.attempts += 1
        return job

    def complete(self, job):
        job.status = "done"
        job.error = None

    def fail(self, job, error):
        job.error = error
        if should_retry(job):
            job.status = "queued"
            job.run_at = self.clock.now() + backoff(job.attempts)
        else:
            job.status = "dead"

    def stats(self):
        out = {}
        for j in self.jobs.values():
            out[j.status] = out.get(j.status, 0) + 1
        return out

class Worker:
    def __init__(self, queue, handlers):
        self.queue = queue
        self.handlers = handlers

    def run_once(self):
        job = self.queue.pop_ready()
        if job is None:
            return False
        handler = self.handlers.get(job.name)
        if handler is None:
            self.queue.fail(job, "no handler")
            return True
        try:
            handler(job.payload)
        except Exception as e:  # noqa: BLE001
            self.queue.fail(job, repr(e))
        else:
            self.queue.complete(job)
        return True

    def run_until_idle(self, max_steps=1000):
        n = 0
        while n < max_steps and self.run_once():
            n += 1
        return n

def backoff(attempt, base=2.0, cap=60.0):
    """Delay in seconds before retry number `attempt` (1 = first retry): base * 2**(attempt-1), capped."""
    return min(cap, base * 2 ** (attempt - 1))


def should_retry(job):
    """A job may run at most `max_attempts` times in total."""
    return job.attempts <= job.max_attempts

import json

from .jobs import Job
from .queue import JobQueue

_FIELDS = ["id", "name", "payload", "priority", "attempts", "max_attempts", "run_at", "status", "error"]


def dump(queue):
    return json.dumps({"n": queue._n, "jobs": [{f: getattr(j, f) for f in _FIELDS} for j in queue.jobs.values()]})


def load(clock, text):
    data = json.loads(text)
    q = JobQueue(clock)
    q._n = data["n"]
    for d in data["jobs"]:
        q.jobs[d["id"]] = Job(**{f: d[f] for f in _FIELDS})
    return q

from dataclasses import dataclass


@dataclass
class Job:
    id: str
    name: str
    payload: dict
    priority: int = 0
    attempts: int = 0
    max_attempts: int = 3
    run_at: float = 0.0
    status: str = "queued"  # queued | running | done | dead
    error: str | None = None

import unittest

from taskq.clock import FakeClock
from taskq.queue import JobQueue
from taskq.retry import backoff
from taskq.store import dump, load
from taskq.worker import Worker


class TaskqTests(unittest.TestCase):
    def test_priority_order(self):
        q = JobQueue(FakeClock())
        q.enqueue("a", priority=1)
        hi = q.enqueue("b", priority=5)
        self.assertEqual(q.pop_ready().id, hi.id)

    def test_delay(self):
        c = FakeClock()
        q = JobQueue(c)
        q.enqueue("a", delay=10)
        self.assertIsNone(q.pop_ready())
        c.advance(10)
        self.assertIsNotNone(q.pop_ready())

    def test_worker_and_roundtrip(self):
        c = FakeClock()
        q = JobQueue(c)
        q.enqueue("ok", {"x": 1})
        seen = []
        Worker(q, {"ok": seen.append}).run_until_idle()
        self.assertEqual(seen, [{"x": 1}])
        self.assertEqual(load(c, dump(q)).stats(), {"done": 1})
        self.assertEqual(backoff(1), 2.0)


if __name__ == "__main__":
    unittest.main()

### MODEL (turn 2)
The bug is in `should_retry`: it uses `<=`, so a job whose third attempt fails still gets requeued. Since `pop_ready` counts the attempt before the handler runs, the check should be `<`. I'll make that change and run the test suite.
