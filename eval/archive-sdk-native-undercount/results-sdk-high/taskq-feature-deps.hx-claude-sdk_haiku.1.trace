    def _kill_dependents(self, root_id):
        """Mark every queued job that transitively depends on `root_id` as dead."""
        frontier = [root_id]
        while frontier:
            dead_id = frontier.pop()
            for j in self.jobs.values():
                if j.status == "queued" and dead_id in j.depends_on:
                    j.status = "dead"
                    j.error = f"dependency failed: {root_id}"
                    frontier.append(j.id)
