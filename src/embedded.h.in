#ifndef HX_EMBEDDED_H_
#define HX_EMBEDDED_H_

#include <string_view>
#include <utility>

namespace hx {

// The version in CMakeLists.txt, for --version.
inline constexpr std::string_view kVersion = "@PROJECT_VERSION@";

// lua/loop.luau, embedded at configure time.
inline constexpr std::string_view kDefaultLoop = R"HXLUAU(@HX_LOOP_SOURCE@)HXLUAU";

// lua/overlay.luau: what `hx --init` writes to .hx/loop.luau, a loop that loads the one above and changes parts.
inline constexpr std::string_view kLoopOverlay = R"HXLUAU(@HX_OVERLAY_SOURCE@)HXLUAU";

// lua/judge.luau: the judge that --judge KIT runs in a process of its own.
inline constexpr std::string_view kJudge = R"HXLUAU(@HX_JUDGE_SOURCE@)HXLUAU";

// lua/ext/*.luau, in file name order: the built-in extensions, which ext(NAME) loads when the project has no
// .hx/ext/NAME.luau. CMakeLists.txt writes one {NAME, source} line per file.
inline constexpr std::pair<std::string_view, std::string_view> kExtensions[] = {
@HX_EXTENSIONS@};

// The built-in skills, in name order: the text of each one's SKILL.md, which skill(NAME) loads when no skill
// directory has one of that name. CMakeLists.txt writes one {NAME, text} line per skill it lists.
inline constexpr std::pair<std::string_view, std::string_view> kSkills[] = {
@HX_SKILLS@};

}  // namespace hx

#endif  // HX_EMBEDDED_H_
