write("wiki/toc.py", [==[
import re


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def _unique(texts):
    """Slugify each text; later duplicates get -2, -3, ... (never colliding)."""
    seen, out = set(), []
    for t in texts:
        base = slug(t)
        cand, n = base, 1
        while cand in seen:
            n += 1
            cand = f"{base}-{n}"
        seen.add(cand)
        out.append(cand)
    return out


def build(blocks):
    """[(level, text, slug)] for every heading block, in order, with unique slugs."""
    heads = [b for b in blocks if b[0] == "heading"]
    return [(h[1], h[2], s) for h, s in zip(heads, _unique([h[2] for h in heads]))]
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline
from .toc import build


def render(blocks):
    heads = build(blocks)
    hi = 0
    out = []
    for b in blocks:
        kind = b[0]
        if kind == "heading":
            _, level, text, sl = heads[hi][0], b[1], b[2], heads[hi][2]
            hi += 1
            out.append(f'<h{level} id="{sl}">{inline.render(text)}</h{level}>')
        elif kind == "para":
            out.append(f"<p>{inline.render(b[1])}</p>")
        elif kind == "list":
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ul>")
        elif kind == "olist":
            out.append("<ol>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ol>")
        elif kind == "toc":
            if heads:
                items = "".join(f'<li><a href="#{sl}">{inline.render(t)}</a></li>' for _, t, sl in heads)
                out.append(f'<nav class="toc"><ul>{items}</ul></nav>')
            else:
                out.append('<nav class="toc"></nav>')
        elif kind == "code":
            out.append(f"<pre><code>{_html.escape(b[1], quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {kind}")
    return "\n".join(out)
