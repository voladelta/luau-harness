edit("ledger/reports.py", [==[def balance_sheet(journal):]==], [==[def register(journal, account, start=None, end=None):
    """Chronological account register. Balance is running over all rows (including before start)."""
    pairs = sorted(journal.entries_for(account), key=lambda p: p[0].date)  # stable: keeps posting order on ties
    rows = []
    balance = 0
    for e, cents in pairs:
        balance += cents
        if start is not None and e.date < start:
            continue
        if end is not None and e.date > end:
            continue
        rows.append({"date": e.date, "memo": e.memo, "amount": cents, "balance": balance})
    return rows


def format_register(rows):
    from .money import fmt
    return "\n".join(
        f"{r['date']}  {r['memo']:<20}  {fmt(r['amount']):>12}  {fmt(r['balance']):>12}" for r in rows
    )


