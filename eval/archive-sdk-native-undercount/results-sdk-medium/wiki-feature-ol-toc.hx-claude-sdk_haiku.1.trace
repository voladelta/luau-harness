write("wiki/blocks.py", [==[
import re

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")
_OLIST = re.compile(r"^\d+\.\s+(.*\S)\s*$")


def parse(text):
    """Split markdown-lite into blocks:
    ("heading", level, text) | ("para", text) | ("list", [items])
    | ("olist", [items]) | ("code", text) | ("toc",)
    """
    blocks, para, items, kind, code = [], [], [], None, None

    def flush():
        nonlocal para, items, kind
        if para:
            blocks.append(("para", " ".join(para)))
            para = []
        if items:
            blocks.append(("list" if kind == "ul" else "olist", items))
            items = []
        kind = None

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(("code", "\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        om = _OLIST.match(line)
        if m:
            flush()
            blocks.append(("heading", len(m.group(1)), m.group(2)))
        elif line.strip() == "[TOC]":
            flush()
            blocks.append(("toc",))
        elif line.startswith("- "):
            if para or kind == "ol":
                flush()
            kind = "ul"
            items.append(line[2:].strip())
        elif om:
            if para or kind == "ul":
                flush()
            kind = "ol"
            items.append(om.group(1))
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(("code", "\n".join(code)))
    return blocks
