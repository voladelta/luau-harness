    def test_cancel_queued(self):
        c = FakeClock(5.0)
        q = JobQueue(c)
        a = q.enqueue("a")
        b = q.enqueue("b")
        c.advance(3)
        got = q.cancel(a.id)
        self.assertIs(got, a)
        self.assertEqual(a.status, "cancelled")
        self.assertEqual(a.cancelled_at, 8.0)
        self.assertIsNone(b.cancelled_at)
        self.assertIs(q.pop_ready(), b)
        self.assertIsNone(q.pop_ready())
        self.assertEqual(q.stats(), {"cancelled": 1, "running": 1})

    def test_cancel_idempotent_and_errors(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a")
        first = q.cancel(a.id).cancelled_at
        self.assertEqual(q.cancel(a.id).cancelled_at, first)
        self.assertRaises(KeyError, q.cancel, "job-999")
        running = q.enqueue("r")
        q.pop_ready()
        with self.assertRaises(ValueError) as cm:
            q.cancel(running.id)
        self.assertEqual(str(cm.exception), f"cannot cancel running job: {running.id}")
        q.complete(running)
        with self.assertRaises(ValueError):
            q.cancel(running.id)

    def test_cancelled_not_retried(self):
        c = FakeClock()
        q = JobQueue(c)
        q.enqueue("a")
        q.enqueue("b")
        j = q.pop_ready()
        q.fail(j, "boom")
        self.assertEqual(j.status, "queued")
        q.cancel(j.id)
        c.advance(1000)
        self.assertEqual(q.pop_ready().id, "job-2")
        self.assertIsNone(q.pop_ready())

    def test_roundtrip_cancelled_at(self):
        c = FakeClock(1.0)
        q = JobQueue(c)
        a = q.enqueue("a")
        q.cancel(a.id)
        q2 = load(c, dump(q))
        self.assertEqual(q2.jobs[a.id].status, "cancelled")
        self.assertEqual(q2.jobs[a.id].cancelled_at, 1.0)

    def test_load_old_dump_without_cancelled_at(self):
        old = {"n": 1, "jobs": [{"id": "job-1", "name": "a", "payload": {}, "priority": 0,
                                 "attempts": 0, "max_attempts": 3, "run_at": 0.0,
                                 "status": "queued", "error": None}]}
        q = load(FakeClock(), json.dumps(old))
        self.assertIsNone(q.jobs["job-1"].cancelled_at)
        self.assertEqual(q.jobs["job-1"].status, "queued")
]])

