=== shop/pricing.py ===
from .discounts import discount_for
from .tax import tax_for


def line_total(item):
    return round(item.price * item.qty, 2)


def subtotal(cart):
    return round(sum(line_total(i) for i in cart.items), 2)


def total(cart, region):
    sub = subtotal(cart)
    disc = discount_for(cart, cart.coupon)
    tax = tax_for(sub, region)
    return {"subtotal": sub, "discount": disc, "tax": tax, "total": round(sub - disc + tax, 2)}

=== shop/discounts.py ===
def discount_for(cart, code):
    """Discount amount in dollars for `code` on `cart`. Unknown codes raise ValueError."""
    if not code:
        return 0.0
    sub = sum(i.price * i.qty for i in cart.items)
    if code == "SAVE10":
        return round(sub * 0.10, 2)
    if code == "FIVEOFF":
        return 5.0 if sub >= 30 else 0.0
    raise ValueError(f"unknown coupon: {code}")

=== shop/tax.py ===
RATES = {"CA": 0.0725, "NY": 0.04, "OR": 0.0}


def tax_for(amount, region):
    rate = RATES.get(region)
    if rate is None:
        raise ValueError(f"unknown region: {region}")
    return round(amount * rate, 2)

=== shop/orders.py ===
import itertools

from .pricing import line_total, total

_ids = itertools.count(1)


def place_order(cart, region):
    t = total(cart, region)
    lines = [{"sku": i.sku, "name": i.name, "qty": i.qty, "total": line_total(i)} for i in cart.items]
    return {"id": f"ORD-{next(_ids):04d}", "region": region, "lines": lines, **t}

=== shop/models.py ===
from dataclasses import dataclass, field


@dataclass
class Item:
    sku: str
    name: str
    price: float
    qty: int = 1


@dataclass
class Cart:
    items: list = field(default_factory=list)
    coupon: str | None = None

    def add(self, item):
        for it in self.items:
            if it.sku == item.sku:
                it.qty += item.qty
                return
        self.items.append(Item(item.sku, item.name, item.price, item.qty))

    def remove(self, sku):
        self.items = [i for i in self.items if i.sku != sku]

    def count(self):
        return sum(i.qty for i in self.items)

=== tests/test_shop.py ===
import unittest

from shop.fmt import money
from shop.models import Cart, Item
from shop.orders import place_order
from shop.pricing import subtotal, total


def cart(*items, coupon=None):
    c = Cart(coupon=coupon)
    for it in items:
        c.add(it)
    return c


class ShopTests(unittest.TestCase):
    def test_merge_and_subtotal(self):
        c = cart(Item("a", "A", 2.5, 2), Item("a", "A", 2.5, 1))
        self.assertEqual(c.count(), 3)
        self.assertEqual(subtotal(c), 7.5)

    def test_total_no_coupon(self):
        t = total(cart(Item("a", "A", 10.0, 1)), "NY")
        self.assertEqual(t["total"], 10.4)

    def test_fiveoff(self):
        t = total(cart(Item("a", "A", 40.0, 1), coupon="FIVEOFF"), "OR")
        self.assertEqual((t["discount"], t["total"]), (5.0, 35.0))

    def test_order_and_money(self):
        o = place_order(cart(Item("a", "A", 1.0, 1)), "OR")
        self.assertTrue(o["id"].startswith("ORD-"))
        self.assertEqual(money(1234.5), "$1,234.50")


if __name__ == "__main__":
    unittest.main()

### MODEL (turn 2)
The bug is in `total()`: it passes the pre-discount subtotal to `tax_for`, so tax is charged on the full price. I'll make tax apply to the discounted amount, add a regression test for SAVE10 in California, and run the suite.
