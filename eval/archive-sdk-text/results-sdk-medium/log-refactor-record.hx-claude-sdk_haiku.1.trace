from .stats import count_by, error_rate, latency_summary


def table(rows, cols):
    """rows: sequences of values, ordered like cols."""
    widths = [max(len(str(c)), *(len(str(row[i])) for row in rows)) if rows else len(str(c)) for i, c in enumerate(cols)]
    lines = ["  ".join(str(c).ljust(w) for c, w in zip(cols, widths))]
    lines += ["  ".join(str(v).ljust(w) for v, w in zip(row, widths)) for row in rows]
    return "\n".join(lines)


def summary_text(records):
    lat = latency_summary(records)
    out = [f"records: {len(records)}", f"error rate: {error_rate(records):.1%}"]
    out.append(table([[k, v] for k, v in sorted(count_by(records, "level").items())], ["level", "count"]))
    if lat["count"]:
        out.append(f"latency ms: p50={lat['p50']:g} p95={lat['p95']:g} max={lat['max']:g}")
    return "\n".join(out)
