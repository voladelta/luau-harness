write("shop/cli.py", [==[
import json
import sys

from .fmt import receipt
from .models import Cart, Item
from .orders import place_order

USAGE = "usage: shop CART.json REGION [--coupon CODE]"


def load_cart(path):
    with open(path) as f:
        data = json.load(f)
    cart = Cart(coupon=data.get("coupon"))
    for it in data["items"]:
        cart.add(Item(it["sku"], it["name"], it["price"], it.get("qty", 1)))
    return cart


def main(argv):
    if len(argv) < 2:
        print(USAGE, file=sys.stderr)
        return 2
    cart_path, region, rest = argv[0], argv[1], list(argv[2:])
    coupon = None
    if rest:
        if len(rest) != 2 or rest[0] != "--coupon":
            print(USAGE, file=sys.stderr)
            return 2
        coupon = rest[1]
    cart = load_cart(cart_path)
    if coupon is not None:
        cart.coupon = coupon
    print(receipt(place_order(cart, region)))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
]==])

write("tests/test_shop.py", [==[
import io
import json
import os
import tempfile
import unittest
from contextlib import redirect_stderr, redirect_stdout

from shop.cli import main
from shop.discounts import discount_for
from shop.fmt import money, receipt
from shop.models import Cart, Item
from shop.orders import place_order
from shop.pricing import subtotal, total


def cart(*items, coupon=None):
    c = Cart(coupon=coupon)
    for it in items:
        c.add(it)
    return c


class ShopTests(unittest.TestCase):
    def test_merge_and_subtotal(self):
        c = cart(Item("a", "A", 2.5, 2), Item("a", "A", 2.5, 1))
        self.assertEqual(c.count(), 3)
        self.assertEqual(subtotal(c), 7.5)

    def test_total_no_coupon(self):
        t = total(cart(Item("a", "A", 10.0, 1)), "NY")
        self.assertEqual(t["total"], 10.4)

    def test_fiveoff(self):
        t = total(cart(Item("a", "A", 40.0, 1), coupon="FIVEOFF"), "OR")
        self.assertEqual((t["discount"], t["total"]), (5.0, 35.0))

    def test_order_and_money(self):
        o = place_order(cart(Item("a", "A", 1.0, 1)), "OR")
        self.assertTrue(o["id"].startswith("ORD-"))
        self.assertEqual(money(1234.5), "$1,234.50")

    def test_buy2get1(self):
        c = cart(Item("A1", "A", 10.0, 3), Item("B2", "B", 4.0, 6))
        self.assertEqual(discount_for(c, "BUY2GET1:A1"), 10.0)
        self.assertEqual(discount_for(c, "BUY2GET1:B2"), 8.0)
        self.assertEqual(discount_for(cart(Item("A1", "A", 10.0, 2)), "BUY2GET1:A1"), 0.0)
        self.assertEqual(discount_for(c, "BUY2GET1:ZZ"), 0.0)

    def test_buy2get1_malformed_and_unknown(self):
        c = cart(Item("A1", "A", 10.0, 3))
        for bad in ("BUY2GET1:", "BUY2GET1", "BOGUS"):
            with self.assertRaises(ValueError):
                discount_for(c, bad)

    def test_order_coupon_key(self):
        o = place_order(cart(Item("A1", "A", 10.0, 3), coupon="BUY2GET1:A1"), "OR")
        self.assertEqual(o["coupon"], "BUY2GET1:A1")
        self.assertEqual(o["discount"], 10.0)
        self.assertIsNone(place_order(cart(Item("a", "A", 1.0)), "OR")["coupon"])

    def test_receipt_discount_line(self):
        o = place_order(cart(Item("A1", "A", 10.0, 3), coupon="BUY2GET1:A1"), "OR")
        self.assertIn("Discount (BUY2GET1:A1): -$10.00", receipt(o))
        o = place_order(cart(Item("a", "A", 1.0)), "OR")
        self.assertNotIn("Discount", receipt(o))

    def _run(self, data, args):
        fd, path = tempfile.mkstemp(suffix=".json")
        with os.fdopen(fd, "w") as f:
            json.dump(data, f)
        out, err = io.StringIO(), io.StringIO()
        try:
            with redirect_stdout(out), redirect_stderr(err):
                code = main([path] + args)
        finally:
            os.remove(path)
        return code, out.getvalue(), err.getvalue()

    def test_cli_coupon_override(self):
        data = {"items": [{"sku": "A1", "name": "A", "price": 10.0, "qty": 3}], "coupon": "SAVE10"}
        code, out, _ = self._run(data, ["OR"])
        self.assertEqual(code, 0)
        self.assertIn("Discount (SAVE10)", out)
        code, out, _ = self._run(data, ["OR", "--coupon", "BUY2GET1:A1"])
        self.assertEqual(code, 0)
        self.assertIn("Discount (BUY2GET1:A1): -$10.00", out)

    def test_cli_usage_errors(self):
        data = {"items": [{"sku": "A1", "name": "A", "price": 10.0}]}
        for args in (["OR", "--coupon"], ["OR", "--bogus", "x"], ["OR", "--coupon", "X", "extra"]):
            code, out, err = self._run(data, args)
            self.assertEqual(code, 2)
            self.assertIn("usage", err)
            self.assertEqual(out, "")


if __name__ == "__main__":
    unittest.main()
]==])

