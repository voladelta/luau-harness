def register(journal, account, start=None, end=None):
    pairs = sorted(journal.entries_for(account), key=lambda p: p[0].date)  # stable
    rows = []
    bal = 0
    for e, c in pairs:
        bal += c
        if (start is None or e.date >= start) and (end is None or e.date <= end):
            rows.append({"date": e.date, "memo": e.memo, "amount": c, "balance": bal})
    return rows


def format_register(rows):
    from .money import fmt
    return "\n".join(
        f"{r['date']}  {r['memo']:<20}  {fmt(r['amount']):>12}  {fmt(r['balance']):>12}" for r in rows
    )
