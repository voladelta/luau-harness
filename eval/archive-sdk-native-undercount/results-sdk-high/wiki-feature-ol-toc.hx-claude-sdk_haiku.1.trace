write("wiki/blocks.py", [==[
import re

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")
_OLIST = re.compile(r"^\d+\.\s+(.*)$")


def parse(text):
    """Split markdown-lite into blocks:
    ("heading", level, text) | ("para", text) | ("list", [items])
    | ("olist", [items]) | ("code", text) | ("toc",)
    """
    blocks, para, items, items_kind, code = [], [], [], None, None

    def flush():
        nonlocal para, items
        if para:
            blocks.append(("para", " ".join(para)))
            para = []
        if items:
            blocks.append((items_kind, items))
            items = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(("code", "\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        om = _OLIST.match(line)
        if m:
            flush()
            blocks.append(("heading", len(m.group(1)), m.group(2)))
        elif line.strip() == "[TOC]":
            flush()
            blocks.append(("toc",))
        elif line.startswith("- ") or om:
            kind = "olist" if om else "list"
            if para or (items and items_kind != kind):
                flush()
            items_kind = kind
            items.append(om.group(1).strip() if om else line[2:].strip())
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(("code", "\n".join(code)))
    return blocks
]==])

write("wiki/toc.py", [==[
import re


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def _unique(base, used):
    candidate, n = base, 1
    while candidate in used:
        n += 1
        candidate = f"{base}-{n}"
    used.add(candidate)
    return candidate


def build(blocks):
    """[(level, text, slug)] for every heading block, in order.
    Slugs are unique within the document: repeats get -2, -3, ... appended."""
    used = set()
    return [(b[1], b[2], _unique(slug(b[2]), used)) for b in blocks if b[0] == "heading"]
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline, toc


def _toc_html(headings):
    if not headings:
        return '<nav class="toc"></nav>'
    items = "".join(f'<li><a href="#{s}">{inline.render(t)}</a></li>' for _, t, s in headings)
    return f'<nav class="toc"><ul>{items}</ul></nav>'


def render(blocks):
    headings = toc.build(blocks)
    heading_iter = iter(headings)
    out = []
    for b in blocks:
        kind = b[0]
        if kind == "heading":
            _, _, hid = next(heading_iter)
            out.append(f'<h{b[1]} id="{hid}">{inline.render(b[2])}</h{b[1]}>')
        elif kind == "para":
            out.append(f"<p>{inline.render(b[1])}</p>")
        elif kind == "list":
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ul>")
        elif kind == "olist":
            out.append("<ol>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ol>")
        elif kind == "toc":
            out.append(_toc_html(headings))
        elif kind == "code":
            out.append(f"<pre><code>{_html.escape(b[1], quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {kind}")
    return "\n".join(out)
]==])

write("tests/test_wiki.py", [==[
import unittest

from wiki.convert import convert
from wiki.links import extract
from wiki.toc import build, slug
from wiki import blocks


class WikiTests(unittest.TestCase):
    def test_convert(self):
        out = convert("# Hi There\n\nsome *em* and `x*y*` text\n\n- a\n- b\n")
        self.assertIn('<h1 id="hi-there">Hi There</h1>', out)
        self.assertIn("<em>em</em>", out)
        self.assertIn("<code>x*y*</code>", out)
        self.assertIn("<ul><li>a</li><li>b</li></ul>", out)

    def test_code_and_links(self):
        self.assertIn("<pre><code>a &lt; b</code></pre>", convert("```\na < b\n```"))
        self.assertEqual(extract("see [x](http://a) and [y](b)"), [("x", "http://a"), ("y", "b")])

    def test_toc(self):
        self.assertEqual(build(blocks.parse("# A\n## B c")), [(1, "A", "a"), (2, "B c", "b-c")])
        self.assertEqual(slug("Hello, World!"), "hello-world")

    def test_ordered_list(self):
        self.assertEqual(
            convert("1. one\n2. **two**\n"),
            "<ol><li>one</li><li><strong>two</strong></li></ol>",
        )

    def test_ordered_list_after_paragraph_and_switch(self):
        self.assertEqual(
            convert("text\n1. a\n2. b\n- c\n\n3. d"),
            "<p>text</p>\n<ol><li>a</li><li>b</li></ol>\n<ul><li>c</li></ul>\n<ol><li>d</li></ol>",
        )

    def test_ordered_list_needs_dot_and_space(self):
        self.assertEqual(convert("1.5 apples"), "<p>1.5 apples</p>")

    def test_toc_includes_headings_after_marker(self):
        out = convert("[TOC]\n\n# Intro\n## Setup `x`\n# Later")
        self.assertEqual(
            out.split("\n")[0],
            '<nav class="toc"><ul><li><a href="#intro">Intro</a></li>'
            '<li><a href="#setup-x">Setup <code>x</code></a></li>'
            '<li><a href="#later">Later</a></li></ul></nav>',
        )
        self.assertIn('<h2 id="setup-x">Setup <code>x</code></h2>', out)

    def test_toc_without_headings(self):
        self.assertEqual(convert("[TOC]"), '<nav class="toc"></nav>')

    def test_unique_slugs(self):
        doc = "# intro\n# intro\n# intro-2\n# intro"
        expected = ["intro", "intro-2", "intro-2-2", "intro-3"]
        self.assertEqual([s for _, _, s in build(blocks.parse(doc))], expected)
        out = convert("[TOC]\n" + doc)
        for s in expected:
            self.assertIn(f'<a href="#{s}">', out)
            self.assertIn(f' id="{s}">', out)


if __name__ == "__main__":
    unittest.main()
]==])

