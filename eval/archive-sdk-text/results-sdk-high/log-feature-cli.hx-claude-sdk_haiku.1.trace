write("tests/test_logkit.py", [==[
import contextlib
import io
import json
import os
import tempfile
import unittest

from logkit.cli import main
from logkit.filters import between, by_level
from logkit.parser import parse_line
from logkit.render import json_line
from logkit.stats import percentile
from logkit.timeutil import parse_ts

LINE = '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"'
ERR_LINE = "2026-01-05T10:00:09Z ERROR db ms=900 boom"
LATE_LINE = '2026-01-05T10:00:12Z WARN auth user=bob ms=40 "late"'


def run_cli(lines, args):
    with tempfile.TemporaryDirectory() as d:
        path = os.path.join(d, "app.log")
        with open(path, "w") as f:
            f.write("\n".join(lines) + "\n")
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = main([path] + args)
    return code, out.getvalue(), err.getvalue()


class LogkitTests(unittest.TestCase):
    def test_parse(self):
        r = parse_line(LINE)
        self.assertEqual((r["level"], r["component"], r["fields"]["ms"], r["msg"]), ("INFO", "auth", "120", "login ok"))
        self.assertIsNone(parse_line("garbage"))

    def test_filters(self):
        rs = [parse_line(LINE), parse_line(ERR_LINE)]
        self.assertEqual(len(by_level(rs, "WARN")), 1)
        self.assertEqual(len(between(rs, start=parse_ts("2026-01-05T10:00:05Z"))), 1)

    def test_percentile(self):
        self.assertEqual(percentile([1, 2, 3, 4, 5], 50), 3)

    def test_json_line(self):
        s = json_line(parse_line(LINE))
        self.assertNotIn("\n", s)
        self.assertEqual(list(json.loads(s).keys()), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(json.loads(s), {
            "ts": "2026-01-05T10:00:03Z",
            "level": "INFO",
            "component": "auth",
            "fields": {"user": "alice", "ms": "120"},
            "msg": "login ok",
        })

    def test_cli_since_inclusive_until_exclusive(self):
        code, out, _ = run_cli([LINE, ERR_LINE, LATE_LINE],
                               ["--since", "2026-01-05T10:00:03Z", "--until", "2026-01-05T10:00:12Z"])
        self.assertEqual(code, 0)
        self.assertEqual(out.splitlines(), [LINE, ERR_LINE])

    def test_cli_until_excludes_boundary(self):
        code, out, _ = run_cli([LINE, ERR_LINE], ["--until", "2026-01-05T10:00:09Z"])
        self.assertEqual(out.splitlines(), [LINE])

    def test_cli_since_combines_with_level(self):
        code, out, _ = run_cli([LINE, ERR_LINE, LATE_LINE], ["--since", "2026-01-05T10:00:05Z", "--level", "WARN"])
        self.assertEqual(out.splitlines(), [LATE_LINE])

    def test_cli_bad_timestamp(self):
        code, out, err = run_cli([LINE], ["--since", "yesterday"])
        self.assertEqual(code, 2)
        self.assertEqual(out, "")
        self.assertIn("--since", err)

    def test_cli_naive_timestamp_rejected(self):
        code, _, err = run_cli([LINE], ["--until", "2026-01-05T10:00:00"])
        self.assertEqual(code, 2)
        self.assertIn("--until", err)

    def test_cli_json(self):
        code, out, _ = run_cli([LINE, ERR_LINE], ["--json", "--level", "ERROR"])
        self.assertEqual(code, 0)
        lines = out.splitlines()
        self.assertEqual(len(lines), 1)
        obj = json.loads(lines[0])
        self.assertEqual((obj["ts"], obj["msg"]), ("2026-01-05T10:00:09Z", "boom"))

    def test_cli_summary_wins_over_json(self):
        code, out, _ = run_cli([LINE, ERR_LINE], ["--json", "--summary"])
        self.assertTrue(out.startswith("records: 2"))


if __name__ == "__main__":
    unittest.main()
]==])

