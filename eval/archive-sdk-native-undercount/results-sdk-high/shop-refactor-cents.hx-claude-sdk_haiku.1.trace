@dataclass
class Item:
    sku: str
    name: str
    price_cents: int
    qty: int = 1


@dataclass
class Cart:
    items: list = field(default_factory=list)
    coupon: str | None = None

    def add(self, item):
        for it in self.items:
            if it.sku == item.sku:
                it.qty += item.qty
                return
        self.items.append(Item(item.sku, item.name, item.price_cents, item.qty))

    def remove(self, sku):
        self.items = [i for i in self.items if i.sku != sku]

    def count(self):
        return sum(i.qty for i in self.items)
]==])

