write("shop/discounts.py", [==[
BUY2GET1_PREFIX = "BUY2GET1:"


def discount_for(cart, code):
    """Discount amount in dollars for `code` on `cart`. Unknown codes raise ValueError."""
    if not code:
        return 0.0
    sub = sum(i.price * i.qty for i in cart.items)
    if code == "SAVE10":
        return round(sub * 0.10, 2)
    if code == "FIVEOFF":
        return 5.0 if sub >= 30 else 0.0
    if code.startswith(BUY2GET1_PREFIX):
        sku = code[len(BUY2GET1_PREFIX):]
        if not sku:
            raise ValueError(f"malformed coupon: {code}")
        for it in cart.items:
            if it.sku == sku:
                return round((it.qty // 3) * it.price, 2) if it.qty >= 3 else 0.0
        return 0.0
    raise ValueError(f"unknown coupon: {code}")
