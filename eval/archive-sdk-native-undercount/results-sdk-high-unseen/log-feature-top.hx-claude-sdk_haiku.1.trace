write("tests/test_logkit.py", [==[import contextlib
import io
import os
import tempfile
import unittest

from logkit.cli import main
from logkit.filters import between, by_level
from logkit.parser import parse_line
from logkit.stats import percentile, top_n
from logkit.timeutil import parse_ts

LINE = '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"'

# components: auth 2, cache 2, db 2, api 1 ; levels: INFO 3, ERROR 2, DEBUG 1, WARN 1
FIXTURE = """\
2026-01-05T10:00:01Z INFO auth
2026-01-05T10:00:02Z INFO auth
2026-01-05T10:00:03Z ERROR db
2026-01-05T10:00:04Z WARN cache
2026-01-05T10:00:05Z INFO db
2026-01-05T10:00:06Z ERROR cache
2026-01-05T10:00:07Z DEBUG api
"""


def fixture_records():
    return [parse_line(line) for line in FIXTURE.splitlines()]


class LogkitTests(unittest.TestCase):
    def test_parse(self):
        r = parse_line(LINE)
        self.assertEqual((r["level"], r["component"], r["fields"]["ms"], r["msg"]), ("INFO", "auth", "120", "login ok"))
        self.assertIsNone(parse_line("garbage"))

    def test_filters(self):
        rs = [parse_line(LINE), parse_line("2026-01-05T10:00:09Z ERROR db ms=900 boom")]
        self.assertEqual(len(by_level(rs, "WARN")), 1)
        self.assertEqual(len(between(rs, start=parse_ts("2026-01-05T10:00:05Z"))), 1)

    def test_percentile(self):
        self.assertEqual(percentile([1, 2, 3, 4, 5], 50), 3)

    def test_top_n_orders_by_count_then_value(self):
        rs = fixture_records()
        self.assertEqual(top_n(rs, "component", 3), [("auth", 2), ("cache", 2), ("db", 2)])
        self.assertEqual(top_n(rs, "level", 2), [("INFO", 3), ("ERROR", 2)])
        self.assertEqual(top_n(rs, "level", 4)[2:], [("DEBUG", 1), ("WARN", 1)])

    def test_top_n_edge_cases(self):
        rs = fixture_records()
        self.assertEqual(len(top_n(rs, "component", 50)), 4)
        self.assertEqual(top_n(rs, "component", 0), [])
        self.assertEqual(top_n(rs, "component", -3), [])
        self.assertEqual(top_n([], "level", 2), [])

    def run_cli(self, args):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "app.log")
            with open(path, "w") as f:
                f.write(FIXTURE)
            out, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                code = main([path] + args)
            return code, out.getvalue(), err.getvalue()

    def test_cli_top(self):
        self.assertEqual(self.run_cli(["--top", "component", "2"]), (0, "auth 2\ncache 2\n", ""))
        self.assertEqual(self.run_cli(["--level", "ERROR", "--top", "component", "5"]), (0, "cache 1\ndb 1\n", ""))

    def test_cli_top_errors(self):
        code, out, err = self.run_cli(["--top", "host", "2"])
        self.assertEqual((code, out), (2, ""))
        self.assertIn("host", err)
        code, out, err = self.run_cli(["--top", "level", "many"])
        self.assertEqual((code, out), (2, ""))
        self.assertIn("integer", err)
        code, _, _ = self.run_cli(["--top", "level"])
        self.assertEqual(code, 2)


if __name__ == "__main__":
    unittest.main()
]==])

