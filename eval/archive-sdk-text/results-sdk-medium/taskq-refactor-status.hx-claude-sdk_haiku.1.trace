import json

from .jobs import Job, Status
from .queue import JobQueue

_FIELDS = ["id", "name", "payload", "priority", "attempts", "max_attempts", "run_at", "status", "error"]


def _job_to_dict(j):
    d = {f: getattr(j, f) for f in _FIELDS}
    d["status"] = j.status.value
    return d


def dump(queue):
    return json.dumps({"n": queue._n, "jobs": [_job_to_dict(j) for j in queue.jobs.values()]})


def load(clock, text):
    data = json.loads(text)
    q = JobQueue(clock)
    q._n = data["n"]
    for d in data["jobs"]:
        kw = {f: d[f] for f in _FIELDS}
        kw["status"] = Status(kw["status"])
        q.jobs[d["id"]] = Job(**kw)
    return q
