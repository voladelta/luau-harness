=== logkit/stats.py ===
import math
from collections import Counter


def count_by(records, key):
    return dict(Counter(r[key] for r in records))


def percentile(values, p):
    """Nearest-rank percentile: sorted[ceil(p/100 * n) - 1]."""
    if not values:
        raise ValueError("no values")
    s = sorted(values)
    rank = max(1, math.ceil(p / 100 * len(s)))
    return s[rank - 1]


def latency_summary(records, field="ms"):
    vals = [float(r["fields"][field]) for r in records if field in r["fields"]]
    if not vals:
        return {"count": 0, "p50": None, "p95": None, "max": None}
    return {"count": len(vals), "p50": percentile(vals, 50), "p95": percentile(vals, 95), "max": max(vals)}


def error_rate(records):
    if not records:
        return 0.0
    return sum(1 for r in records if r["level"] == "ERROR") / len(records)

=== logkit/cli.py ===
import sys

from .filters import by_component, by_level
from .parser import read_records
from .render import summary_text


def main(argv):
    if not argv:
        print("usage: logkit FILE [--level L] [--component C] [--summary]", file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    records = read_records(path)
    i = 0
    summary = False
    while i < len(opts):
        if opts[i] == "--level":
            records = by_level(records, opts[i + 1])
            i += 2
        elif opts[i] == "--component":
            records = by_component(records, opts[i + 1])
            i += 2
        elif opts[i] == "--summary":
            summary = True
            i += 1
        else:
            print(f"unknown option: {opts[i]}", file=sys.stderr)
            return 2
    if summary:
        print(summary_text(records))
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

=== logkit/filters.py ===
from .parser import LEVELS


def by_level(records, min_level):
    floor = LEVELS.index(min_level)
    return [r for r in records if LEVELS.index(r["level"]) >= floor]


def by_component(records, component):
    return [r for r in records if r["component"] == component]


def between(records, start=None, end=None):
    """start inclusive, end exclusive; either may be None."""
    return [r for r in records if (start is None or r["ts"] >= start) and (end is None or r["ts"] < end)]


def has_field(records, name):
    return [r for r in records if name in r["fields"]]

=== logkit/parser.py ===
import shlex

from .timeutil import parse_ts

LEVELS = ["DEBUG", "INFO", "WARN", "ERROR"]


def parse_line(line):
    """`<ts> <LEVEL> <component> key=value ... ["message"]` -> record dict, or None if malformed."""
    parts = line.strip().split(None, 3)
    if len(parts) < 3 or parts[1] not in LEVELS:
        return None
    try:
        ts = parse_ts(parts[0])
    except ValueError:
        return None
    fields, msg = {}, []
    for tok in shlex.split(parts[3]) if len(parts) == 4 else []:
        if "=" in tok:
            k, v = tok.split("=", 1)
            fields[k] = v
        else:
            msg.append(tok)
    return {"ts": ts, "level": parts[1], "component": parts[2], "fields": fields, "msg": " ".join(msg), "raw": line.rstrip("\n")}


def read_records(path):
    with open(path) as f:
        return [r for r in map(parse_line, f) if r]

=== logkit/render.py ===
from .stats import count_by, error_rate, latency_summary


def table(rows, cols):
    widths = [max(len(str(c)), *(len(str(r[c])) for r in rows)) if rows else len(str(c)) for c in cols]
    lines = ["  ".join(str(c).ljust(w) for c, w in zip(cols, widths))]
    lines += ["  ".join(str(r[c]).ljust(w) for c, w in zip(cols, widths)) for r in rows]
    return "\n".join(lines)


def summary_text(records):
    lat = latency_summary(records)
    out = [f"records: {len(records)}", f"error rate: {error_rate(records):.1%}"]
    out.append(table([{"level": k, "count": v} for k, v in sorted(count_by(records, "level").items())], ["level", "count"]))
    if lat["count"]:
        out.append(f"latency ms: p50={lat['p50']:g} p95={lat['p95']:g} max={lat['max']:g}")
    return "\n".join(out)

=== logkit/timeutil.py ===
from datetime import datetime, timezone


def parse_ts(s):
    """Parse an ISO-8601 UTC timestamp like 2026-01-05T10:00:03Z."""
    return datetime.fromisoformat(s.replace("Z", "+00:00")).astimezone(timezone.utc)


def fmt_ts(dt):
    return dt.strftime("%Y-%m-%dT%H:%M:%SZ")


def bucket(dt, seconds):
    """Floor `dt` to a multiple of `seconds` since the epoch."""
    t = int(dt.timestamp())
    return datetime.fromtimestamp(t - t % seconds, tz=timezone.utc)

