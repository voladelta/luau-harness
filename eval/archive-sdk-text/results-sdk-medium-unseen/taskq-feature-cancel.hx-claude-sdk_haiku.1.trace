    def test_cancel_queued_job(self):
        c = FakeClock(5.0)
        q = JobQueue(c)
        a = q.enqueue("a")
        b = q.enqueue("b")
        c.advance(3)
        got = q.cancel(a.id)
        self.assertEqual(got.status, "cancelled")
        self.assertEqual(got.cancelled_at, 8.0)
        self.assertIs(q.pop_ready(), b)
        self.assertIsNone(q.pop_ready())
        self.assertEqual(q.stats(), {"cancelled": 1, "queued": 1})

    def test_cancel_is_idempotent(self):
        c = FakeClock(1.0)
        q = JobQueue(c)
        a = q.enqueue("a")
        q.cancel(a.id)
        c.advance(5)
        again = q.cancel(a.id)
        self.assertEqual(again.cancelled_at, 1.0)

    def test_cancel_rejects_running_done_dead(self):
        q = JobQueue(FakeClock())
        running = q.enqueue("r")
        q.pop_ready()
        done = q.enqueue("d")
        q.complete(q.pop_ready())
        dead = q.enqueue("x", max_attempts=1)
        q.fail(q.pop_ready(), "boom")
        for job, status in [(running, "running"), (done, "done"), (dead, "dead")]:
            with self.assertRaises(ValueError) as cm:
                q.cancel(job.id)
            self.assertEqual(str(cm.exception), f"cannot cancel {status} job: {job.id}")

    def test_cancel_unknown_id(self):
        with self.assertRaises(KeyError):
            JobQueue(FakeClock()).cancel("job-99")

    def test_cancelled_never_retried(self):
        c = FakeClock()
        q = JobQueue(c)
        a = q.enqueue("a", max_attempts=3)
        q.fail(q.pop_ready(), "boom")  # back to queued with a retry delay
        q.cancel(a.id)
        c.advance(1000)
        self.assertIsNone(q.pop_ready())
        self.assertEqual(q.jobs[a.id].attempts, 1)

    def test_cancelled_at_roundtrip_and_old_dumps(self):
        c = FakeClock(2.0)
        q = JobQueue(c)
        a = q.enqueue("a")
        q.cancel(a.id)
        restored = load(c, dump(q))
        self.assertEqual(restored.jobs[a.id].cancelled_at, 2.0)
        self.assertEqual(restored.jobs[a.id].status, "cancelled")
        old = '{"n": 1, "jobs": [{"id": "job-1", "name": "a", "payload": {}, "priority": 0, "attempts": 0, "max_attempts": 3, "run_at": 0.0, "status": "queued", "error": null}]}'
        loaded = load(c, old)
        self.assertIsNone(loaded.jobs["job-1"].cancelled_at)


if __name__ == "__main__":]==]))

