write("wiki/blocks.py", [==[
import re

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")
_OLIST = re.compile(r"^\d+\.\s+(.*)$")


def parse(text):
    """Split markdown-lite into blocks:
    ("heading", level, text) | ("toc",) | ("para", text) |
    ("list", [items]) | ("olist", [items]) | ("code", text)
    """
    blocks, para, items, items_kind, code = [], [], [], None, None

    def flush():
        nonlocal para, items
        if para:
            blocks.append(("para", " ".join(para)))
            para = []
        if items:
            blocks.append((items_kind, items))
            items = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(("code", "\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        om = _OLIST.match(line)
        if m:
            flush()
            blocks.append(("heading", len(m.group(1)), m.group(2)))
        elif line.strip() == "[TOC]":
            flush()
            blocks.append(("toc",))
        elif line.startswith("- ") or om:
            kind = "olist" if om else "list"
            if para or (items and items_kind != kind):
                flush()
            items_kind = kind
            items.append(om.group(1).strip() if om else line[2:].strip())
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(("code", "\n".join(code)))
    return blocks
]==])

write("wiki/toc.py", [==[
import re


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build(blocks):
    """[(level, text, slug)] for every heading block, in order.
    Slugs are unique: the first keeps its slug, repeats get -2, -3, ... appended."""
    used, out = set(), []
    for b in blocks:
        if b[0] != "heading":
            continue
        base = slug(b[2])
        s, n = base, 2
        while s in used:
            s = f"{base}-{n}"
            n += 1
        used.add(s)
        out.append((b[1], b[2], s))
    return out
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline
from .toc import build


def render(blocks):
    heads = build(blocks)
    head_iter = iter(heads)
    out = []
    for b in blocks:
        kind = b[0]
        if kind == "heading":
            _, _, sl = next(head_iter)
            out.append(f'<h{b[1]} id="{sl}">{inline.render(b[2])}</h{b[1]}>')
        elif kind == "toc":
            if heads:
                links = "".join(f'<li><a href="#{sl}">{inline.render(text)}</a></li>' for _, text, sl in heads)
                out.append(f'<nav class="toc"><ul>{links}</ul></nav>')
            else:
                out.append('<nav class="toc"></nav>')
        elif kind == "para":
            out.append(f"<p>{inline.render(b[1])}</p>")
        elif kind == "list":
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ul>")
        elif kind == "olist":
            out.append("<ol>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ol>")
        elif kind == "code":
            out.append(f"<pre><code>{_html.escape(b[1], quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {kind}")
    return "\n".join(out)
]==])

write("tests/test_wiki.py", [==[
import unittest

from wiki.convert import convert
from wiki.links import extract
from wiki.toc import build, slug
from wiki import blocks


class WikiTests(unittest.TestCase):
    def test_convert(self):
        out = convert("# Hi There\n\nsome *em* and `x*y*` text\n\n- a\n- b\n")
        self.assertIn('<h1 id="hi-there">Hi There</h1>', out)
        self.assertIn("<em>em</em>", out)
        self.assertIn("<code>x*y*</code>", out)
        self.assertIn("<ul><li>a</li><li>b</li></ul>", out)

    def test_code_and_links(self):
        self.assertIn("<pre><code>a &lt; b</code></pre>", convert("```\na < b\n```"))
        self.assertEqual(extract("see [x](http://a) and [y](b)"), [("x", "http://a"), ("y", "b")])

    def test_toc(self):
        self.assertEqual(build(blocks.parse("# A\n## B c")), [(1, "A", "a"), (2, "B c", "b-c")])
        self.assertEqual(slug("Hello, World!"), "hello-world")

    def test_ordered_lists(self):
        self.assertIn("<ol><li>one</li><li><strong>two</strong></li></ol>",
                      convert("1. one\n2. **two**\n"))
        self.assertEqual(convert("text\n1. a\n2. b"),
                         "<p>text</p>\n<ol><li>a</li><li>b</li></ol>")
        self.assertEqual(convert("- a\n1. b"),
                         "<ul><li>a</li></ul>\n<ol><li>b</li></ol>")
        self.assertEqual(convert("1. a\n\n2. b"),
                         "<ol><li>a</li></ol>\n<ol><li>b</li></ol>")
        self.assertEqual(convert("1. a\n# H"),
                         '<ol><li>a</li></ol>\n<h1 id="h">H</h1>')

    def test_toc_block(self):
        out = convert("[TOC]\n\n# Intro\n## Setup *now*\n# Intro")
        self.assertEqual(out.split("\n")[0],
                         '<nav class="toc"><ul><li><a href="#intro">Intro</a></li>'
                         '<li><a href="#setup-now">Setup <em>now</em></a></li>'
                         '<li><a href="#intro-2">Intro</a></li></ul></nav>')
        self.assertIn('<h2 id="setup-now">Setup <em>now</em></h2>', out)
        self.assertIn('<h1 id="intro-2">Intro</h1>', out)

    def test_toc_empty(self):
        self.assertEqual(convert("[TOC]\n\nno headings here"),
                         '<nav class="toc"></nav>\n<p>no headings here</p>')

    def test_unique_slugs(self):
        self.assertEqual(build(blocks.parse("# Intro\n# intro\n# Intro")),
                         [(1, "Intro", "intro"), (1, "intro", "intro-2"), (1, "Intro", "intro-3")])
        self.assertIn('id="intro-2"', convert("# Intro\n\n# Intro"))


if __name__ == "__main__":
    unittest.main()
]==])

