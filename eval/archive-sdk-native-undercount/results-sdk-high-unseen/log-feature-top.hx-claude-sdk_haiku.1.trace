import shlex

from .timeutil import parse_ts

LEVELS = ["DEBUG", "INFO", "WARN", "ERROR"]


def parse_line(line):
    """`<ts> <LEVEL> <component> key=value ... ["message"]` -> record dict, or None if malformed."""
    parts = line.strip().split(None, 3)
    if len(parts) < 3 or parts[1] not in LEVELS:
        return None
    try:
        ts = parse_ts(parts[0])
    except ValueError:
        return None
    fields, msg = {}, []
    for tok in shlex.split(parts[3]) if len(parts) == 4 else []:
        if "=" in tok:
            k, v = tok.split("=", 1)
            fields[k] = v
        else:
            msg.append(tok)
    return {"ts": ts, "level": parts[1], "component": parts[2], "fields": fields, "msg": " ".join(msg), "raw": line.rstrip("\n")}


def read_records(path):
    with open(path) as f:
        return [r for r in map(parse_line, f) if r]

-----
from .stats import count_by, error_rate, latency_summary


def table(rows, cols):
    widths = [max(len(str(c)), *(len(str(r[c])) for r in rows)) if rows else len(str(c)) for c in cols]
    lines = ["  ".join(str(c).ljust(w) for c, w in zip(cols, widths))]
    lines += ["  ".join(str(r[c]).ljust(w) for c, w in zip(cols, widths)) for r in rows]
    return "\n".join(lines)


def summary_text(records):
    lat = latency_summary(records)
    out = [f"records: {len(records)}", f"error rate: {error_rate(records):.1%}"]
    out.append(table([{"level": k, "count": v} for k, v in sorted(count_by(records, "level").items())], ["level", "count"]))
    if lat["count"]:
        out.append(f"latency ms: p50={lat['p50']:g} p95={lat['p95']:g} max={lat['max']:g}")
    return "\n".join(out)

