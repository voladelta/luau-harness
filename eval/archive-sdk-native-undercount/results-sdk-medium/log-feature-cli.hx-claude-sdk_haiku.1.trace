write("logkit/cli.py", [==[import sys
from datetime import datetime

from .filters import between, by_component, by_level
from .parser import read_records
from .render import json_line, summary_text
from .timeutil import parse_ts


def parse_bound(s):
    """Parse a --since/--until value. It must carry an explicit UTC offset (e.g. trailing Z)."""
    if datetime.fromisoformat(s.replace("Z", "+00:00")).tzinfo is None:
        raise ValueError("missing UTC offset")
    return parse_ts(s)


def main(argv):
    if not argv:
        print("usage: logkit FILE [--level L] [--component C] [--since TS] [--until TS] [--json] [--summary]", file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    records = read_records(path)
    i = 0
    summary = False
    as_json = False
    since = until = None
    while i < len(opts):
        if opts[i] == "--level":
            records = by_level(records, opts[i + 1])
            i += 2
        elif opts[i] == "--component":
            records = by_component(records, opts[i + 1])
            i += 2
        elif opts[i] in ("--since", "--until"):
            if i + 1 >= len(opts):
                print(f"missing value for {opts[i]}", file=sys.stderr)
                return 2
            try:
                bound = parse_bound(opts[i + 1])
            except ValueError:
                print(f"invalid timestamp for {opts[i]}: {opts[i + 1]!r} (expected UTC like 2026-01-05T10:00:00Z)", file=sys.stderr)
                return 2
            if opts[i] == "--since":
                since = bound
            else:
                until = bound
            i += 2
        elif opts[i] == "--summary":
            summary = True
            i += 1
        elif opts[i] == "--json":
            as_json = True
            i += 1
        else:
            print(f"unknown option: {opts[i]}", file=sys.stderr)
            return 2
    records = between(records, start=since, end=until)
    if summary:
        print(summary_text(records))
    elif as_json:
        for r in records:
            print(json_line(r))
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
]==])

write("tests/test_cli.py", [==[import contextlib
import io
import json
import os
import tempfile
import unittest

from logkit.cli import main
from logkit.parser import parse_line
from logkit.render import json_line

LOG = """\
2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"
2026-01-05T10:00:05Z WARN auth user=bob "slow"
2026-01-05T10:00:09Z ERROR db ms=900 boom
2026-01-05T10:00:12Z INFO db ms=40 "ok"
"""


def run(argv):
    out, err = io.StringIO(), io.StringIO()
    with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
        code = main(argv)
    return code, out.getvalue(), err.getvalue()


class CliTests(unittest.TestCase):
    def setUp(self):
        fd, self.path = tempfile.mkstemp(suffix=".log")
        with os.fdopen(fd, "w") as f:
            f.write(LOG)

    def tearDown(self):
        os.remove(self.path)

    def test_since_inclusive_until_exclusive(self):
        code, out, _ = run([self.path, "--since", "2026-01-05T10:00:05Z", "--until", "2026-01-05T10:00:12Z"])
        self.assertEqual(code, 0)
        self.assertEqual(out.splitlines(), [LOG.splitlines()[1], LOG.splitlines()[2]])

    def test_since_combines_with_level_and_component(self):
        code, out, _ = run([self.path, "--since", "2026-01-05T10:00:04Z", "--level", "WARN", "--component", "auth"])
        self.assertEqual(code, 0)
        self.assertEqual(out.splitlines(), [LOG.splitlines()[1]])

    def test_since_with_summary(self):
        _, out, _ = run([self.path, "--until", "2026-01-05T10:00:10Z", "--summary"])
        self.assertTrue(out.startswith("records: 3\n"))

    def test_invalid_ts_returns_2(self):
        for bad in ["yesterday", "2026-01-05T10:00:00", "2026-13-05T10:00:00Z"]:
            code, out, err = run([self.path, "--since", bad])
            self.assertEqual(code, 2, bad)
            self.assertEqual(out, "")
            self.assertIn("invalid timestamp", err)

    def test_missing_ts_value_returns_2(self):
        code, _, err = run([self.path, "--until"])
        self.assertEqual(code, 2)
        self.assertIn("--until", err)

    def test_json_output(self):
        code, out, _ = run([self.path, "--json", "--component", "db"])
        self.assertEqual(code, 0)
        lines = out.splitlines()
        self.assertEqual(len(lines), 2)
        first = json.loads(lines[0])
        self.assertEqual(list(first), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(first, {"ts": "2026-01-05T10:00:09Z", "level": "ERROR", "component": "db",
                                 "fields": {"ms": "900"}, "msg": "boom"})

    def test_summary_wins_over_json(self):
        _, out, _ = run([self.path, "--json", "--summary"])
        self.assertTrue(out.startswith("records: 4\n"))


class RenderTests(unittest.TestCase):
    def test_json_line(self):
        r = parse_line('2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"')
        s = json_line(r)
        self.assertFalse(s.endswith("\n"))
        self.assertEqual(s, '{"ts": "2026-01-05T10:00:03Z", "level": "INFO", "component": "auth", '
                            '"fields": {"user": "alice", "ms": "120"}, "msg": "login ok"}')


if __name__ == "__main__":
    unittest.main()
]==])

