import html
import re

from wiki import links

_CODE = re.compile(r"`([^`]+)`")
_BOLD = re.compile(r"\*\*(.+?)\*\*")
_EM = re.compile(r"\*(.+?)\*")


def render(text):
    """Inline markup -> HTML. Code spans are protected from further formatting."""
    text = html.escape(text, quote=False)
    spans = []

    def stash(m):
        spans.append(f"<code>{m.group(1)}</code>")
        return f"\x00{len(spans) - 1}\x00"

    text = _CODE.sub(stash, text)
    text = _BOLD.sub(r"<strong>\1</strong>", text)
    text = _EM.sub(r"<em>\1</em>", text)
    text = links.LINK_RE.sub(lambda m: links.render_link(m.group(1), m.group(2)), text)
    return re.sub(r"\x00(\d+)\x00", lambda m: spans[int(m.group(1))], text)

### MODEL (turn 4)
The link pattern now lives only in `wiki/links.py` as `LINK_RE`, and `links.render_link(label, url)` holds the anchor markup. `links.extract` and `inline.render` both use these, and `inline.py` no longer defines its own pattern. I added assertions to `tests/test_wiki.py` for `LINK_RE`, `render_link`, and inline link rendering. All 3 tests pass.
