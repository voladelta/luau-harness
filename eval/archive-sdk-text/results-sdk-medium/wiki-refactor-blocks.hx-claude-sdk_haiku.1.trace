write("wiki/blocks.py", [==[
import re
from dataclasses import dataclass

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")


@dataclass
class Heading:
    level: int
    text: str


@dataclass
class Para:
    text: str


@dataclass
class ListBlock:
    items: list


@dataclass
class Code:
    text: str


def parse(text):
    """Split markdown-lite into Heading, Para, ListBlock and Code blocks."""
    blocks, para, items, code = [], [], [], None

    def flush():
        nonlocal para, items
        if para:
            blocks.append(Para(" ".join(para)))
            para = []
        if items:
            blocks.append(ListBlock(items))
            items = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(Code("\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        if m:
            flush()
            blocks.append(Heading(len(m.group(1)), m.group(2)))
        elif line.startswith("- "):
            if para:
                flush()
            items.append(line[2:].strip())
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(Code("\n".join(code)))
    return blocks
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline
from .blocks import Code, Heading, ListBlock, Para
from .toc import slug


def render(blocks):
    out = []
    for b in blocks:
        if isinstance(b, Heading):
            out.append(f'<h{b.level} id="{slug(b.text)}">{inline.render(b.text)}</h{b.level}>')
        elif isinstance(b, Para):
            out.append(f"<p>{inline.render(b.text)}</p>")
        elif isinstance(b, ListBlock):
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b.items) + "</ul>")
        elif isinstance(b, Code):
            out.append(f"<pre><code>{_html.escape(b.text, quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {type(b).__name__}")
    return "\n".join(out)
]==])

write("wiki/toc.py", [==[
import re

from .blocks import Code, Heading, ListBlock, Para


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build(blocks):
    """[(level, text, slug)] for every Heading block, in order."""
    out = []
    for b in blocks:
        if isinstance(b, Heading):
            out.append((b.level, b.text, slug(b.text)))
        elif not isinstance(b, (Para, ListBlock, Code)):
            raise ValueError(f"unknown block: {type(b).__name__}")
    return out
]==])

write("tests/test_wiki.py", [==[
import unittest

from wiki import blocks, html
from wiki.convert import convert
from wiki.links import extract
from wiki.toc import build, slug


class WikiTests(unittest.TestCase):
    def test_convert(self):
        out = convert("# Hi There\n\nsome *em* and `x*y*` text\n\n- a\n- b\n")
        self.assertIn('<h1 id="hi-there">Hi There</h1>', out)
        self.assertIn("<em>em</em>", out)
        self.assertIn("<code>x*y*</code>", out)
        self.assertIn("<ul><li>a</li><li>b</li></ul>", out)

    def test_code_and_links(self):
        self.assertIn("<pre><code>a &lt; b</code></pre>", convert("```\na < b\n```"))
        self.assertEqual(extract("see [x](http://a) and [y](b)"), [("x", "http://a"), ("y", "b")])

    def test_toc(self):
        self.assertEqual(build(blocks.parse("# A\n## B c")), [(1, "A", "a"), (2, "B c", "b-c")])
        self.assertEqual(slug("Hello, World!"), "hello-world")

    def test_parse_returns_dataclasses(self):
        self.assertEqual(
            blocks.parse("# A\n\nhi\n\n- x\n\n```\nc\n```"),
            [
                blocks.Heading(1, "A"),
                blocks.Para("hi"),
                blocks.ListBlock(["x"]),
                blocks.Code("c"),
            ],
        )

    def test_unknown_block_raises(self):
        with self.assertRaisesRegex(ValueError, "^unknown block"):
            html.render([object()])
        with self.assertRaisesRegex(ValueError, "^unknown block"):
            build([object()])


if __name__ == "__main__":
    unittest.main()
