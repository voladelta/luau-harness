write("logkit/cli.py", [==[import sys

from .filters import by_component, by_level
from .parser import read_records
from .render import summary_text
from .stats import top_n

TOP_KEYS = ("level", "component")


def main(argv):
    if not argv:
        print("usage: logkit FILE [--level L] [--component C] [--summary] [--top KEY N]", file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    records = read_records(path)
    i = 0
    summary = False
    top = None
    while i < len(opts):
        if opts[i] == "--level":
            records = by_level(records, opts[i + 1])
            i += 2
        elif opts[i] == "--component":
            records = by_component(records, opts[i + 1])
            i += 2
        elif opts[i] == "--summary":
            summary = True
            i += 1
        elif opts[i] == "--top":
            if i + 2 >= len(opts):
                print("usage: --top KEY N", file=sys.stderr)
                return 2
            key, n_text = opts[i + 1], opts[i + 2]
            if key not in TOP_KEYS:
                print(f"--top key must be one of {', '.join(TOP_KEYS)}; got {key!r}", file=sys.stderr)
                return 2
            try:
                n = int(n_text)
            except ValueError:
                print(f"--top N must be an integer; got {n_text!r}", file=sys.stderr)
                return 2
            top = (key, n)
            i += 3
        else:
            print(f"unknown option: {opts[i]}", file=sys.stderr)
            return 2
    if summary:
        print(summary_text(records))
    elif top is not None:
        key, n = top
        for value, count in top_n(records, key, n):
            print(f"{value} {count}")
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
