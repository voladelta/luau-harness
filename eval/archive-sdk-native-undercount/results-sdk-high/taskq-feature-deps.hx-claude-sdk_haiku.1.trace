    def test_dependency_gates_pop(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a")
        b = q.enqueue("b", depends_on=[a.id])
        self.assertEqual(b.depends_on, [a.id])
        self.assertEqual(q.pop_ready().id, a.id)
        self.assertIsNone(q.pop_ready())  # b waits for a to be done
        q.complete(a)
        self.assertEqual(q.pop_ready().id, b.id)

    def test_unknown_dependency_rejected(self):
        q = JobQueue(FakeClock())
        with self.assertRaises(ValueError) as cm:
            q.enqueue("a", depends_on=["job-99"])
        self.assertEqual(str(cm.exception), "unknown dependency: job-99")
        self.assertEqual(q.jobs, {})

    def test_dead_dependency_kills_transitive_dependents(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a", max_attempts=1)
        b = q.enqueue("b", depends_on=[a.id])
        c = q.enqueue("c", depends_on=[b.id])
        d = q.enqueue("d")
        e = q.enqueue("e", depends_on=[d.id])
        self.assertIs(q.pop_ready(), a)
        q.fail(a, "boom")
        self.assertEqual(a.status, "dead")
        for j in (b, c):
            self.assertEqual(j.status, "dead")
            self.assertEqual(j.error, f"dependency failed: {a.id}")
            self.assertEqual(j.attempts, 0)
        self.assertEqual(d.status, "queued")
        self.assertEqual(e.status, "queued")

    def test_retry_does_not_kill_dependents(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a", max_attempts=3)
        b = q.enqueue("b", depends_on=[a.id])
        q.pop_ready()
        q.fail(a, "flaky")
        self.assertEqual(a.status, "queued")
        self.assertEqual(b.status, "queued")
        self.assertIsNone(q.pop_ready())  # a is in backoff, b is blocked

    def test_depends_on_roundtrip_and_legacy_load(self):
        c = FakeClock()
        q = JobQueue(c)
        a = q.enqueue("a")
        q.enqueue("b", depends_on=[a.id])
        q2 = load(c, dump(q))
        self.assertEqual(q2.jobs["job-2"].depends_on, [a.id])
        legacy = json.dumps({"n": 1, "jobs": [{
            "id": "job-1", "name": "a", "payload": {}, "priority": 0, "attempts": 0,
            "max_attempts": 3, "run_at": 0.0, "status": "queued", "error": None}]})
        self.assertEqual(load(c, legacy).jobs["job-1"].depends_on, [])


