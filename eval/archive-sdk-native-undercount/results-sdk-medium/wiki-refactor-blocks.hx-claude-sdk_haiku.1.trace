write("wiki/blocks.py", [==[
import re
from dataclasses import dataclass, field

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")


@dataclass
class Heading:
    level: int
    text: str


@dataclass
class Para:
    text: str


@dataclass
class ListBlock:
    items: list = field(default_factory=list)


@dataclass
class Code:
    text: str


def parse(text):
    """Split markdown-lite into Heading | Para | ListBlock | Code blocks."""
    blocks, para, items, code = [], [], [], None

    def flush():
        nonlocal para, items
        if para:
            blocks.append(Para(" ".join(para)))
            para = []
        if items:
            blocks.append(ListBlock(items))
            items = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(Code("\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        if m:
            flush()
            blocks.append(Heading(len(m.group(1)), m.group(2)))
        elif line.startswith("- "):
            if para:
                flush()
            items.append(line[2:].strip())
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(Code("\n".join(code)))
    return blocks
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline
from .blocks import Code, Heading, ListBlock, Para
from .toc import slug


def render(blocks):
    out = []
    for b in blocks:
        if isinstance(b, Heading):
            out.append(f'<h{b.level} id="{slug(b.text)}">{inline.render(b.text)}</h{b.level}>')
        elif isinstance(b, Para):
            out.append(f"<p>{inline.render(b.text)}</p>")
        elif isinstance(b, ListBlock):
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b.items) + "</ul>")
        elif isinstance(b, Code):
            out.append(f"<pre><code>{_html.escape(b.text, quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {type(b).__name__}")
    return "\n".join(out)
]==])

write("wiki/toc.py", [==[
import re

from .blocks import Code, Heading, ListBlock, Para


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build(blocks):
    """[(level, text, slug)] for every heading block, in order."""
    out = []
    for b in blocks:
        if isinstance(b, Heading):
            out.append((b.level, b.text, slug(b.text)))
        elif not isinstance(b, (Para, ListBlock, Code)):
            raise ValueError(f"unknown block: {type(b).__name__}")
    return out
]==])

