write("taskq/queue.py", [==[
from .jobs import Job
from .retry import backoff, should_retry


class JobQueue:
    def __init__(self, clock):
        self.clock = clock
        self.jobs = {}
        self._n = 0

    def enqueue(self, name, payload=None, priority=0, delay=0.0, max_attempts=3, depends_on=None):
        deps = list(depends_on or [])
        for dep in deps:
            if dep not in self.jobs:
                raise ValueError(f"unknown dependency: {dep}")
        self._n += 1
        job = Job(f"job-{self._n}", name, payload or {}, priority, 0, max_attempts,
                  self.clock.now() + delay, depends_on=deps)
        self.jobs[job.id] = job
        return job

    def pop_ready(self):
        """Highest priority first, then earliest run_at, then creation order. Counts an attempt.
        A job is ready only when it is queued, due, and all its dependencies are done."""
        now = self.clock.now()
        ready = [j for j in self.jobs.values()
                 if j.status == "queued" and j.run_at <= now and self._deps_done(j)]
        if not ready:
            return None
        job = min(ready, key=lambda j: (-j.priority, j.run_at, int(j.id.split("-")[1])))
        job.status = "running"
        job.attempts += 1
        return job

    def _deps_done(self, job):
        return all(self.jobs[d].status == "done" for d in job.depends_on)

    def complete(self, job):
        job.status = "done"
        job.error = None

    def fail(self, job, error):
        job.error = error
        if should_retry(job):
            job.status = "queued"
            job.run_at = self.clock.now() + backoff(job.attempts)
        else:
            job.status = "dead"
            self._kill_dependents(job.id)

    def _kill_dependents(self, root_id):
        """Mark every queued job that transitively depends on root_id as dead."""
        error = f"dependency failed: {root_id}"
        frontier = [root_id]
        while frontier:
            dead_id = frontier.pop()
            for j in self.jobs.values():
                if j.status == "queued" and dead_id in j.depends_on:
                    j.status = "dead"
                    j.error = error
                    frontier.append(j.id)

    def stats(self):
        out = {}
        for j in self.jobs.values():
            out[j.status] = out.get(j.status, 0) + 1
        return out
]==])

write("taskq/store.py", [==[
import json

from .jobs import Job
from .queue import JobQueue

_FIELDS = ["id", "name", "payload", "priority", "attempts", "max_attempts", "run_at", "status", "error", "depends_on"]


def dump(queue):
    return json.dumps({"n": queue._n, "jobs": [{f: getattr(j, f) for f in _FIELDS} for j in queue.jobs.values()]})


def load(clock, text):
    data = json.loads(text)
    q = JobQueue(clock)
    q._n = data["n"]
    for d in data["jobs"]:
        # Older dumps lack newer optional fields; Job's defaults fill them in.
        q.jobs[d["id"]] = Job(**{f: d[f] for f in _FIELDS if f in d})
    return q
]==])

