write("shop/discounts.py", [==[
def discount_for(cart, code):
    """Discount in integer cents for `code` on `cart`. Unknown codes raise ValueError."""
    if not code:
        return 0
    sub = sum(i.price_cents * i.qty for i in cart.items)
    if code == "SAVE10":
        return (sub * 10 + 50) // 100
    if code == "FIVEOFF":
        return 500 if sub >= 3000 else 0
    raise ValueError(f"unknown coupon: {code}")
]==])

write("shop/tax.py", [==[
RATES_BP = {"CA": 725, "NY": 400, "OR": 0}


def tax_for(cents, region):
    """Tax in integer cents on `cents`, rounded half up. Rates are in basis points."""
    bp = RATES_BP.get(region)
    if bp is None:
        raise ValueError(f"unknown region: {region}")
    return (cents * bp + 5000) // 10000
]==])

write("shop/fmt.py", [==[
def money(cents):
    sign = "-" if cents < 0 else ""
    whole, frac = divmod(abs(cents), 100)
    return f"${sign}{whole:,}.{frac:02d}"


def receipt(order):
    out = [f"Order {order['id']} ({order['region']})"]
    for ln in order["lines"]:
        out.append(f"{ln['qty']} x {ln['name']}: {money(ln['total'])}")
    out.append(f"Subtotal: {money(order['subtotal'])}")
    if order["discount"]:
        out.append(f"Discount: -{money(order['discount'])}")
    out.append(f"Tax: {money(order['tax'])}")
    out.append(f"Total: {money(order['total'])}")
    return "\n".join(out)
]==])

