write("logkit/cli.py", [==[
import sys

from .filters import between, by_component, by_level
from .parser import read_records
from .render import json_line, summary_text
from .timeutil import parse_ts

USAGE = "usage: logkit FILE [--level L] [--component C] [--since TS] [--until TS] [--json] [--summary]"
VALUE_OPTS = ("--level", "--component", "--since", "--until")


def parse_cli_ts(value):
    """Accept only UTC timestamps (ending in Z or +00:00), so a naive value is never read as local time."""
    if not (value.endswith("Z") or value.endswith("+00:00")):
        raise ValueError(value)
    return parse_ts(value)


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    level = component = since = until = None
    summary = as_json = False
    i = 0
    while i < len(opts):
        opt = opts[i]
        if opt == "--summary":
            summary = True
            i += 1
            continue
        if opt == "--json":
            as_json = True
            i += 1
            continue
        if opt not in VALUE_OPTS:
            print(f"unknown option: {opt}", file=sys.stderr)
            return 2
        if i + 1 >= len(opts):
            print(f"missing value for {opt}", file=sys.stderr)
            return 2
        value = opts[i + 1]
        i += 2
        if opt == "--level":
            level = value
        elif opt == "--component":
            component = value
        else:
            try:
                ts = parse_cli_ts(value)
            except ValueError:
                print(f"invalid timestamp for {opt}: {value!r} (expected UTC like 2026-01-05T10:00:00Z)", file=sys.stderr)
                return 2
            if opt == "--since":
                since = ts
            else:
                until = ts

    records = read_records(path)
    if level is not None:
        records = by_level(records, level)
    if component is not None:
        records = by_component(records, component)
    records = between(records, since, until)

    if summary:
        print(summary_text(records))
    elif as_json:
        for r in records:
            print(json_line(r))
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
