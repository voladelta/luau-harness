TYPES = ("asset", "liability", "equity", "income", "expense")


class Chart:
    def __init__(self):
        self.accounts = {}

    def add(self, name, type_):
        if type_ not in TYPES:
            raise ValueError(f"bad account type: {type_}")
        if name in self.accounts:
            raise ValueError(f"duplicate account: {name}")
        self.accounts[name] = type_

    def type_of(self, name):
        if name not in self.accounts:
            raise ValueError(f"unknown account: {name}")
        return self.accounts[name]

=== ledger/importer.py
import csv
import io

from .journal import Entry
from .money import parse_amount


def import_csv(text, journal):
    """Rows: date,memo,debit_account,credit_account,amount. Returns number of entries posted."""
    n = 0
    for row in csv.DictReader(io.StringIO(text)):
        cents = parse_amount(row["amount"])
        journal.post(Entry(row["date"], row["memo"], [(row["debit_account"], cents), (row["credit_account"], -cents)]))
        n += 1
    return n

=== ledger/journal.py
from dataclasses import dataclass


@dataclass
class Entry:
    date: str  # YYYY-MM-DD
    memo: str
    lines: list  # [(account, cents)]: debit positive, credit negative; must sum to zero


class Journal:
    def __init__(self, chart):
        self.chart = chart
        self.entries = []

    def post(self, entry):
        if sum(c for _, c in entry.lines) != 0:
            raise ValueError(f"unbalanced entry: {entry.memo}")
        for acct, _ in entry.lines:
            self.chart.type_of(acct)
        self.entries.append(entry)

    def balance(self, account):
        return sum(c for e in self.entries for a, c in e.lines if a == account)

    def trial_balance(self):
        return {a: self.balance(a) for a in self.chart.accounts}

=== ledger/money.py
def parse_amount(s):
    """'12.50' -> 1250 (integer cents). Accepts '1,200', '0.5', '-3.07'. Raises ValueError on junk."""
    s = s.strip().replace(",", "")
    neg = s.startswith("-")
    if neg:
        s = s[1:]
    whole, _, frac = s.partition(".")
    if not whole.isdigit() or (frac and not frac.isdigit()) or len(frac) > 2:
        raise ValueError(f"bad amount: {s!r}")
    cents = int(whole) * 100 + int(frac.ljust(2, "0") or 0)
    return -cents if neg else cents


def fmt(cents):
    sign = "-" if cents < 0 else ""
    cents = abs(cents)
    return f"{sign}{cents // 100:,}.{cents % 100:02d}"

=== ledger/reports.py
def _sum(journal, type_):
    return sum(b for a, b in journal.trial_balance().items() if journal.chart.type_of(a) == type_)


def balance_sheet(journal):
    """Assets = liabilities + equity (+ retained earnings). Credits are negative internally."""
    assets = _sum(journal, "asset")
    liabilities = -_sum(journal, "liability")
    equity = -_sum(journal, "equity")
    retained = -(_sum(journal, "income") + _sum(journal, "expense"))
    return {"assets": assets, "liabilities": liabilities, "equity": equity + retained}


def income_statement(journal, start, end):
    """Dates are YYYY-MM-DD strings; start and end both inclusive."""
    income = expense = 0
    for e in journal.entries:
        if start <= e.date <= end:
            for a, c in e.lines:
                t = journal.chart.type_of(a)
                if t == "income":
                    income += -c
                elif t == "expense":
                    expense += c
    return {"income": income, "expenses": expense, "net": income - expense}

=== tests/test_ledger.py
import unittest

from ledger.accounts import Chart
from ledger.importer import import_csv
from ledger.journal import Entry, Journal
from ledger.money import fmt, parse_amount
from ledger.reports import balance_sheet, income_statement


def make():
    c = Chart()
    for n, t in [("cash", "asset"), ("loan", "liability"), ("capital", "equity"), ("sales", "income"), ("rent", "expense")]:
        c.add(n, t)
    return Journal(c)


class LedgerTests(unittest.TestCase):
    def test_money(self):
        self.assertEqual(parse_amount("1,200.5"), 120050)
        self.assertEqual(fmt(-1234), "-12.34")

    def test_post_and_reports(self):
        j = make()
        j.post(Entry("2026-01-01", "seed", [("cash", 10000), ("capital", -10000)]))
        j.post(Entry("2026-01-02", "sale", [("cash", 5000), ("sales", -5000)]))
        j.post(Entry("2026-01-03", "rent", [("rent", 2000), ("cash", -2000)]))
        self.assertEqual(balance_sheet(j), {"assets": 13000, "liabilities": 0, "equity": 13000})
        self.assertEqual(income_statement(j, "2026-01-01", "2026-01-31")["net"], 3000)
        with self.assertRaises(ValueError):
            j.post(Entry("2026-01-04", "bad", [("cash", 1)]))

    def test_import(self):
        j = make()
        n = import_csv("date,memo,debit_account,credit_account,amount\n2026-01-02,sale,cash,sales,12.50\n", j)
        self.assertEqual((n, j.balance("cash")), (1, 1250))


if __name__ == "__main__":
    unittest.main()

