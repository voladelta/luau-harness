write("shop/cli.py", [==[
import json
import sys

from .fmt import receipt
from .models import Cart, Item
from .orders import place_order

USAGE = "usage: shop CART.json REGION [--coupon CODE]"


def load_cart(path):
    with open(path) as f:
        data = json.load(f)
    cart = Cart(coupon=data.get("coupon"))
    for it in data["items"]:
        cart.add(Item(it["sku"], it["name"], it["price"], it.get("qty", 1)))
    return cart


def main(argv):
    if len(argv) == 2:
        coupon = None
    elif len(argv) == 4 and argv[2] == "--coupon":
        coupon = argv[3]
    else:
        print(USAGE, file=sys.stderr)
        return 2
    cart = load_cart(argv[0])
    if coupon is not None:
        cart.coupon = coupon
    print(receipt(place_order(cart, argv[1])))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
]==])

write("tests/test_shop.py", [==[
import contextlib
import io
import json
import os
import tempfile
import unittest

from shop.cli import main
from shop.discounts import discount_for
from shop.fmt import money, receipt
from shop.models import Cart, Item
from shop.orders import place_order
from shop.pricing import subtotal, total


def cart(*items, coupon=None):
    c = Cart(coupon=coupon)
    for it in items:
        c.add(it)
    return c


class ShopTests(unittest.TestCase):
    def test_merge_and_subtotal(self):
        c = cart(Item("a", "A", 2.5, 2), Item("a", "A", 2.5, 1))
        self.assertEqual(c.count(), 3)
        self.assertEqual(subtotal(c), 7.5)

    def test_total_no_coupon(self):
        t = total(cart(Item("a", "A", 10.0, 1)), "NY")
        self.assertEqual(t["total"], 10.4)

    def test_fiveoff(self):
        t = total(cart(Item("a", "A", 40.0, 1), coupon="FIVEOFF"), "OR")
        self.assertEqual((t["discount"], t["total"]), (5.0, 35.0))

    def test_order_and_money(self):
        o = place_order(cart(Item("a", "A", 1.0, 1)), "OR")
        self.assertTrue(o["id"].startswith("ORD-"))
        self.assertEqual(money(1234.5), "$1,234.50")

    def test_order_includes_coupon(self):
        o = place_order(cart(Item("a", "A", 1.0, 1), coupon="SAVE10"), "OR")
        self.assertEqual(o["coupon"], "SAVE10")
        o = place_order(cart(Item("a", "A", 1.0, 1)), "OR")
        self.assertIsNone(o["coupon"])

    def test_buy2get1_every_third_free(self):
        c = cart(Item("A1", "A", 4.0, 7))
        self.assertEqual(discount_for(c, "BUY2GET1:A1"), 8.0)  # 7 // 3 = 2 free
        c = cart(Item("A1", "A", 4.0, 6))
        self.assertEqual(discount_for(c, "BUY2GET1:A1"), 8.0)
        c = cart(Item("A1", "A", 4.0, 2))
        self.assertEqual(discount_for(c, "BUY2GET1:A1"), 0.0)

    def test_buy2get1_missing_sku_is_zero(self):
        c = cart(Item("A1", "A", 4.0, 3))
        self.assertEqual(discount_for(c, "BUY2GET1:ZZ"), 0.0)

    def test_buy2get1_malformed_raises(self):
        c = cart(Item("A1", "A", 4.0, 3))
        with self.assertRaises(ValueError):
            discount_for(c, "BUY2GET1:")
        with self.assertRaises(ValueError):
            discount_for(c, "BUY2GET1")
        with self.assertRaises(ValueError):
            discount_for(c, "NOPE")

    def test_receipt_discount_line(self):
        o = place_order(cart(Item("A1", "A", 10.0, 3), coupon="BUY2GET1:A1"), "OR")
        self.assertIn("Discount (BUY2GET1:A1): -$10.00", receipt(o))
        o = place_order(cart(Item("A1", "A", 10.0, 1)), "OR")
        self.assertNotIn("Discount", receipt(o))

    def _run_cli(self, argv):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = main(argv)
        return code, out.getvalue(), err.getvalue()

    def test_cli_coupon_override(self):
        with tempfile.TemporaryDirectory() as d:
            path = os.path.join(d, "cart.json")
            with open(path, "w") as f:
                json.dump({"items": [{"sku": "A1", "name": "A", "price": 10.0, "qty": 3}],
                           "coupon": "SAVE10"}, f)
            code, out, _ = self._run_cli([path, "OR"])
            self.assertEqual(code, 0)
            self.assertIn("Discount (SAVE10): -$3.00", out)
            code, out, _ = self._run_cli([path, "OR", "--coupon", "BUY2GET1:A1"])
            self.assertEqual(code, 0)
            self.assertIn("Discount (BUY2GET1:A1): -$10.00", out)

    def test_cli_usage_errors(self):
        code, _, err = self._run_cli(["cart.json", "OR", "--tax", "x"])
        self.assertEqual(code, 2)
        self.assertIn("usage", err)
        code, _, err = self._run_cli(["cart.json", "OR", "--coupon"])
        self.assertEqual(code, 2)
        self.assertIn("usage", err)


if __name__ == "__main__":
    unittest.main()
]==])

