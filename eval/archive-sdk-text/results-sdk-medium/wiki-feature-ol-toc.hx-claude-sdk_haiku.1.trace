write("wiki/blocks.py", [==[
import re

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")
_OLIST = re.compile(r"^\d+\.\s+(.*)$")


def parse(text):
    """Split markdown-lite into blocks:
    ("heading", level, text) | ("para", text) | ("list", [items])
    | ("olist", [items]) | ("code", text) | ("toc",)
    """
    blocks, para, items, olist, code = [], [], [], [], None

    def flush():
        nonlocal para, items, olist
        if para:
            blocks.append(("para", " ".join(para)))
            para = []
        if items:
            blocks.append(("list", items))
            items = []
        if olist:
            blocks.append(("olist", olist))
            olist = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(("code", "\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        om = _OLIST.match(line)
        if line.strip() == "[TOC]":
            flush()
            blocks.append(("toc",))
        elif m:
            flush()
            blocks.append(("heading", len(m.group(1)), m.group(2)))
        elif line.startswith("- "):
            if para or olist:
                flush()
            items.append(line[2:].strip())
        elif om:
            if para or items:
                flush()
            olist.append(om.group(1).strip())
        elif not line.strip():
            flush()
        else:
            if items or olist:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(("code", "\n".join(code)))
    return blocks
]==])

write("wiki/toc.py", [==[
import re


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def unique_slugs(blocks):
    """Slug for every heading block, in order. Repeats get -2, -3, ... suffixes."""
    used, counts, out = set(), {}, []
    for b in blocks:
        if b[0] != "heading":
            continue
        base = slug(b[2])
        cand = base
        if cand in used:
            n = counts.get(base, 1)
            while True:
                n += 1
                cand = f"{base}-{n}"
                if cand not in used:
                    break
            counts[base] = n
        used.add(cand)
        out.append(cand)
    return out


def build(blocks):
    """[(level, text, slug)] for every heading block, in order."""
    heads = [b for b in blocks if b[0] == "heading"]
    return [(b[1], b[2], i) for b, i in zip(heads, unique_slugs(blocks))]
]==])

write("wiki/html.py", [==[
import html as _html

from . import inline
from .toc import build


def _toc_html(entries):
    if not entries:
        return '<nav class="toc"></nav>'
    items = "".join(f'<li><a href="#{i}">{inline.render(t)}</a></li>' for _, t, i in entries)
    return f'<nav class="toc"><ul>{items}</ul></nav>'


def render(blocks):
    entries = build(blocks)
    heads = iter(entries)
    out = []
    for b in blocks:
        kind = b[0]
        if kind == "heading":
            _, _, hid = next(heads)
            out.append(f'<h{b[1]} id="{hid}">{inline.render(b[2])}</h{b[1]}>')
        elif kind == "para":
            out.append(f"<p>{inline.render(b[1])}</p>")
        elif kind == "list":
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ul>")
        elif kind == "olist":
            out.append("<ol>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ol>")
        elif kind == "code":
            out.append(f"<pre><code>{_html.escape(b[1], quote=False)}</code></pre>")
        elif kind == "toc":
            out.append(_toc_html(entries))
        else:
            raise ValueError(f"unknown block: {kind}")
    return "\n".join(out)
]==])

write("tests/test_wiki.py", [==[
import unittest

from wiki.convert import convert
from wiki.links import extract
from wiki.toc import build, slug
from wiki import blocks


class WikiTests(unittest.TestCase):
    def test_convert(self):
        out = convert("# Hi There\n\nsome *em* and `x*y*` text\n\n- a\n- b\n")
        self.assertIn('<h1 id="hi-there">Hi There</h1>', out)
        self.assertIn("<em>em</em>", out)
        self.assertIn("<code>x*y*</code>", out)
        self.assertIn("<ul><li>a</li><li>b</li></ul>", out)

    def test_code_and_links(self):
        self.assertIn("<pre><code>a &lt; b</code></pre>", convert("```\na < b\n```"))
        self.assertEqual(extract("see [x](http://a) and [y](b)"), [("x", "http://a"), ("y", "b")])

    def test_toc(self):
        self.assertEqual(build(blocks.parse("# A\n## B c")), [(1, "A", "a"), (2, "B c", "b-c")])
        self.assertEqual(slug("Hello, World!"), "hello-world")

    def test_ordered_list(self):
        self.assertEqual(blocks.parse("1. one\n2. two"), [("olist", ["one", "two"])])
        out = convert("para\n1. one\n2. **two**\n\nafter")
        self.assertIn("<p>para</p>\n<ol><li>one</li><li><strong>two</strong></li></ol>", out)
        self.assertIn("<p>after</p>", out)
        self.assertIn("<ol><li>x</li></ol>\n<h1", convert("1. x\n# h"))

    def test_toc_block(self):
        out = convert("[TOC]\n\n# Intro\n## Sub\n\n# Intro\n")
        self.assertIn(
            '<nav class="toc"><ul><li><a href="#intro">Intro</a></li>'
            '<li><a href="#sub">Sub</a></li>'
            '<li><a href="#intro-2">Intro</a></li></ul></nav>',
            out,
        )
        self.assertIn('<h1 id="intro-2">Intro</h1>', out)
        self.assertEqual(convert("[TOC]"), '<nav class="toc"></nav>')

    def test_unique_ids(self):
        got = build(blocks.parse("# intro\n# intro\n# intro\n# intro-2"))
        self.assertEqual([i for _, _, i in got], ["intro", "intro-2", "intro-3", "intro-2-2"])


if __name__ == "__main__":
    unittest.main()
]==])

