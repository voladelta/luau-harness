write("taskq/store.py", [==[
import json

from .jobs import Job, Status
from .queue import JobQueue

_FIELDS = ["id", "name", "payload", "priority", "attempts", "max_attempts", "run_at", "status", "error"]


def dump(queue):
    jobs = []
    for j in queue.jobs.values():
        d = {f: getattr(j, f) for f in _FIELDS}
        d["status"] = j.status.value
        jobs.append(d)
    return json.dumps({"n": queue._n, "jobs": jobs})


def load(clock, text):
    data = json.loads(text)
    q = JobQueue(clock)
    q._n = data["n"]
    for d in data["jobs"]:
        kwargs = {f: d[f] for f in _FIELDS}
        kwargs["status"] = Status(kwargs["status"])
        q.jobs[d["id"]] = Job(**kwargs)
    return q
]==])

