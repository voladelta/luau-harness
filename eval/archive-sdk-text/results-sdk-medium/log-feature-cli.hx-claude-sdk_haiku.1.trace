write("logkit/cli.py", [==[
import sys

from .filters import between, by_component, by_level
from .parser import read_records
from .render import json_line, summary_text
from .timeutil import parse_ts

USAGE = "usage: logkit FILE [--level L] [--component C] [--since TS] [--until TS] [--summary] [--json]"


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    level = component = None
    start = end = None
    summary = as_json = False
    i = 0
    while i < len(opts):
        opt = opts[i]
        if opt in ("--level", "--component", "--since", "--until"):
            if i + 1 >= len(opts):
                print(f"missing value for {opt}", file=sys.stderr)
                return 2
            value = opts[i + 1]
            i += 2
            if opt == "--level":
                level = value
            elif opt == "--component":
                component = value
            else:
                try:
                    ts = parse_ts(value)
                except ValueError:
                    print(f"invalid timestamp for {opt}: {value}", file=sys.stderr)
                    return 2
                if opt == "--since":
                    start = ts
                else:
                    end = ts
        elif opt == "--summary":
            summary = True
            i += 1
        elif opt == "--json":
            as_json = True
            i += 1
        else:
            print(f"unknown option: {opt}", file=sys.stderr)
            return 2

    records = read_records(path)
    if start is not None or end is not None:
        records = between(records, start, end)
    if level is not None:
        records = by_level(records, level)
    if component is not None:
        records = by_component(records, component)

    if summary:
        print(summary_text(records))
    elif as_json:
        for r in records:
            print(json_line(r))
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
]==])

write("tests/test_logkit.py", [==[
import contextlib
import io
import json
import os
import tempfile
import unittest

from logkit.cli import main
from logkit.filters import between, by_level
from logkit.parser import parse_line
from logkit.render import json_line
from logkit.stats import percentile
from logkit.timeutil import parse_ts

LINE = '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"'
SAMPLE = """2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"
2026-01-05T10:00:09Z ERROR db ms=900 boom
2026-01-05T10:00:20Z WARN auth user=bob "slow"
"""


class LogkitTests(unittest.TestCase):
    def test_parse(self):
        r = parse_line(LINE)
        self.assertEqual((r["level"], r["component"], r["fields"]["ms"], r["msg"]), ("INFO", "auth", "120", "login ok"))
        self.assertIsNone(parse_line("garbage"))

    def test_filters(self):
        rs = [parse_line(LINE), parse_line("2026-01-05T10:00:09Z ERROR db ms=900 boom")]
        self.assertEqual(len(by_level(rs, "WARN")), 1)
        self.assertEqual(len(between(rs, start=parse_ts("2026-01-05T10:00:05Z"))), 1)

    def test_percentile(self):
        self.assertEqual(percentile([1, 2, 3, 4, 5], 50), 3)

    def test_json_line(self):
        s = json_line(parse_line(LINE))
        self.assertFalse(s.endswith("\n"))
        obj = json.loads(s)
        self.assertEqual(list(obj), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(obj["ts"], "2026-01-05T10:00:03Z")
        self.assertEqual(obj["fields"], {"user": "alice", "ms": "120"})
        self.assertEqual(obj["msg"], "login ok")


class CliTests(unittest.TestCase):
    def setUp(self):
        fd, self.path = tempfile.mkstemp(suffix=".log")
        with os.fdopen(fd, "w") as f:
            f.write(SAMPLE)
        self.addCleanup(os.remove, self.path)

    def run_cli(self, *args):
        out, err = io.StringIO(), io.StringIO()
        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = main([self.path, *args])
        return code, out.getvalue(), err.getvalue()

    def test_since_until(self):
        code, out, _ = self.run_cli("--since", "2026-01-05T10:00:03Z", "--until", "2026-01-05T10:00:20Z")
        self.assertEqual(code, 0)
        self.assertEqual(len(out.splitlines()), 2)

    def test_since_combines_with_level(self):
        code, out, _ = self.run_cli("--since", "2026-01-05T10:00:05Z", "--level", "WARN")
        self.assertEqual(code, 0)
        self.assertEqual(len(out.splitlines()), 1)
        self.assertIn("slow", out)

    def test_bad_timestamp(self):
        code, out, err = self.run_cli("--since", "yesterday")
        self.assertEqual(code, 2)
        self.assertIn("yesterday", err)
        self.assertEqual(out, "")

    def test_json_output(self):
        code, out, _ = self.run_cli("--json", "--level", "WARN")
        self.assertEqual(code, 0)
        lines = out.splitlines()
        self.assertEqual(len(lines), 1)
        obj = json.loads(lines[0])
        self.assertEqual(list(obj), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(obj["ts"], "2026-01-05T10:00:20Z")

    def test_summary_wins_over_json(self):
        code, out, _ = self.run_cli("--json", "--summary")
        self.assertEqual(code, 0)
        self.assertTrue(out.startswith("records: 3"))


if __name__ == "__main__":
    unittest.main()
]==])

