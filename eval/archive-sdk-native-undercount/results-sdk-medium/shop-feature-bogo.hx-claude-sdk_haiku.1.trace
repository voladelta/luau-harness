=== shop/cli.py
import json
import sys

from .fmt import receipt
from .models import Cart, Item
from .orders import place_order


def load_cart(path):
    with open(path) as f:
        data = json.load(f)
    cart = Cart(coupon=data.get("coupon"))
    for it in data["items"]:
        cart.add(Item(it["sku"], it["name"], it["price"], it.get("qty", 1)))
    return cart


def main(argv):
    if len(argv) != 2:
        print("usage: shop CART.json REGION", file=sys.stderr)
        return 2
    print(receipt(place_order(load_cart(argv[0]), argv[1])))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

=== shop/discounts.py
def discount_for(cart, code):
    """Discount amount in dollars for `code` on `cart`. Unknown codes raise ValueError."""
    if not code:
        return 0.0
    sub = sum(i.price * i.qty for i in cart.items)
    if code == "SAVE10":
        return round(sub * 0.10, 2)
    if code == "FIVEOFF":
        return 5.0 if sub >= 30 else 0.0
    raise ValueError(f"unknown coupon: {code}")

=== shop/fmt.py
def money(x):
    return f"${x:,.2f}"


def receipt(order):
    out = [f"Order {order['id']} ({order['region']})"]
    for ln in order["lines"]:
        out.append(f"{ln['qty']} x {ln['name']}: {money(ln['total'])}")
    out.append(f"Subtotal: {money(order['subtotal'])}")
    if order["discount"]:
        out.append(f"Discount: -{money(order['discount'])}")
    out.append(f"Tax: {money(order['tax'])}")
    out.append(f"Total: {money(order['total'])}")
    return "\n".join(out)

=== shop/models.py
from dataclasses import dataclass, field


@dataclass
class Item:
    sku: str
    name: str
    price: float
    qty: int = 1


@dataclass
class Cart:
    items: list = field(default_factory=list)
    coupon: str | None = None

    def add(self, item):
        for it in self.items:
            if it.sku == item.sku:
                it.qty += item.qty
                return
        self.items.append(Item(item.sku, item.name, item.price, item.qty))

    def remove(self, sku):
        self.items = [i for i in self.items if i.sku != sku]

    def count(self):
        return sum(i.qty for i in self.items)

