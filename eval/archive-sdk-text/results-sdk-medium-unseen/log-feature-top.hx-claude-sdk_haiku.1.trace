write("tests/test_logkit.py", [==[import contextlib
import io
import os
import tempfile
import unittest

from logkit.cli import main
from logkit.filters import between, by_level
from logkit.parser import parse_line
from logkit.stats import percentile, top_n
from logkit.timeutil import parse_ts

LINE = '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"'


class LogkitTests(unittest.TestCase):
    def test_parse(self):
        r = parse_line(LINE)
        self.assertEqual((r["level"], r["component"], r["fields"]["ms"], r["msg"]), ("INFO", "auth", "120", "login ok"))
        self.assertIsNone(parse_line("garbage"))

    def test_filters(self):
        rs = [parse_line(LINE), parse_line("2026-01-05T10:00:09Z ERROR db ms=900 boom")]
        self.assertEqual(len(by_level(rs, "WARN")), 1)
        self.assertEqual(len(between(rs, start=parse_ts("2026-01-05T10:00:05Z"))), 1)

    def test_percentile(self):
        self.assertEqual(percentile([1, 2, 3, 4, 5], 50), 3)

    def test_top_n(self):
        rs = [{"component": c} for c in ["db", "auth", "db", "api", "auth", "web"]]
        self.assertEqual(top_n(rs, "component", 2), [("auth", 2), ("db", 2)])
        self.assertEqual(top_n(rs, "component", 10), [("api", 1), ("auth", 2), ("db", 2), ("web", 1)])
        self.assertEqual(top_n(rs, "component", 0), [])
        self.assertEqual(top_n(rs, "component", -3), [])

    def test_cli_top(self):
        lines = [
            "2026-01-05T10:00:01Z INFO auth ms=1 a",
            "2026-01-05T10:00:02Z ERROR db ms=2 b",
            "2026-01-05T10:00:03Z INFO auth ms=3 c",
        ]
        fd, path = tempfile.mkstemp()
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(lines) + "\n")
        try:
            out = io.StringIO()
            with contextlib.redirect_stdout(out):
                self.assertEqual(main([path, "--top", "level", "1"]), 0)
            self.assertEqual(out.getvalue(), "INFO 2\n")

            err = io.StringIO()
            with contextlib.redirect_stderr(err):
                self.assertEqual(main([path, "--top", "ms", "1"]), 2)
                self.assertEqual(main([path, "--top", "level", "x"]), 2)
            self.assertIn("ms", err.getvalue())
        finally:
            os.remove(path)


if __name__ == "__main__":
    unittest.main()
]==])

