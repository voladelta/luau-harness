write("logkit/cli.py", [==[import sys

from .filters import between, by_component, by_level
from .parser import read_records
from .render import json_line, summary_text
from .timeutil import parse_utc

USAGE = "usage: logkit FILE [--level L] [--component C] [--since TS] [--until TS] [--summary] [--json]"


def main(argv):
    if not argv:
        print(USAGE, file=sys.stderr)
        return 2
    path, opts = argv[0], argv[1:]
    records = read_records(path)
    i = 0
    summary = False
    as_json = False
    since = until = None
    while i < len(opts):
        if opts[i] == "--level":
            records = by_level(records, opts[i + 1])
            i += 2
        elif opts[i] == "--component":
            records = by_component(records, opts[i + 1])
            i += 2
        elif opts[i] in ("--since", "--until"):
            if i + 1 >= len(opts):
                print(f"{opts[i]} requires a timestamp", file=sys.stderr)
                return 2
            try:
                bound = parse_utc(opts[i + 1])
            except ValueError:
                print(f"invalid timestamp for {opts[i]}: {opts[i + 1]!r}", file=sys.stderr)
                return 2
            if opts[i] == "--since":
                since = bound
            else:
                until = bound
            i += 2
        elif opts[i] == "--summary":
            summary = True
            i += 1
        elif opts[i] == "--json":
            as_json = True
            i += 1
        else:
            print(f"unknown option: {opts[i]}", file=sys.stderr)
            return 2
    records = between(records, since, until)
    if summary:
        print(summary_text(records))
    elif as_json:
        for r in records:
            print(json_line(r))
    else:
        for r in records:
            print(r["raw"])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
]==])

write("tests/test_logkit.py", [==[import io
import json
import os
import tempfile
import unittest
from contextlib import redirect_stderr, redirect_stdout

from logkit.cli import main
from logkit.filters import between, by_level
from logkit.parser import parse_line
from logkit.render import json_line
from logkit.stats import percentile
from logkit.timeutil import parse_ts, parse_utc

LINE = '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"'
LOG = (
    '2026-01-05T10:00:03Z INFO auth user=alice ms=120 "login ok"\n'
    '2026-01-05T10:00:05Z WARN auth user=bob "slow"\n'
    "2026-01-05T10:00:09Z ERROR db ms=900 boom\n"
)


class LogkitTests(unittest.TestCase):
    def test_parse(self):
        r = parse_line(LINE)
        self.assertEqual((r["level"], r["component"], r["fields"]["ms"], r["msg"]), ("INFO", "auth", "120", "login ok"))
        self.assertIsNone(parse_line("garbage"))

    def test_filters(self):
        rs = [parse_line(LINE), parse_line("2026-01-05T10:00:09Z ERROR db ms=900 boom")]
        self.assertEqual(len(by_level(rs, "WARN")), 1)
        self.assertEqual(len(between(rs, start=parse_ts("2026-01-05T10:00:05Z"))), 1)

    def test_percentile(self):
        self.assertEqual(percentile([1, 2, 3, 4, 5], 50), 3)

    def test_parse_utc(self):
        self.assertEqual(parse_utc("2026-01-05T10:00:00Z"), parse_ts("2026-01-05T10:00:00Z"))
        for bad in ("garbage", "2026-01-05T10:00:00"):
            with self.assertRaises(ValueError):
                parse_utc(bad)

    def test_json_line(self):
        self.assertEqual(
            json_line(parse_line(LINE)),
            '{"ts": "2026-01-05T10:00:03Z", "level": "INFO", "component": "auth", '
            '"fields": {"user": "alice", "ms": "120"}, "msg": "login ok"}',
        )


class CliTests(unittest.TestCase):
    def setUp(self):
        self._tmp = tempfile.TemporaryDirectory()
        self.path = os.path.join(self._tmp.name, "app.log")
        with open(self.path, "w") as f:
            f.write(LOG)

    def tearDown(self):
        self._tmp.cleanup()

    def run_cli(self, *args):
        out, err = io.StringIO(), io.StringIO()
        with redirect_stdout(out), redirect_stderr(err):
            rc = main([self.path, *args])
        return rc, out.getvalue(), err.getvalue()

    def test_since_until(self):
        rc, out, _ = self.run_cli("--since", "2026-01-05T10:00:03Z", "--until", "2026-01-05T10:00:09Z")
        self.assertEqual(rc, 0)
        self.assertEqual(out.splitlines(), LOG.splitlines()[:2])

    def test_since_combines_with_level(self):
        rc, out, _ = self.run_cli("--since", "2026-01-05T10:00:04Z", "--level", "WARN")
        self.assertEqual(rc, 0)
        self.assertEqual(out.splitlines(), LOG.splitlines()[1:2] + LOG.splitlines()[2:3])

    def test_json_output(self):
        rc, out, _ = self.run_cli("--json", "--level", "WARN")
        self.assertEqual(rc, 0)
        rows = [json.loads(line) for line in out.splitlines()]
        self.assertEqual(len(rows), 2)
        self.assertEqual(list(rows[0].keys()), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(rows[0]["ts"], "2026-01-05T10:00:05Z")

    def test_summary_wins_over_json(self):
        rc, out, _ = self.run_cli("--json", "--summary")
        self.assertEqual(rc, 0)
        self.assertTrue(out.startswith("records: 3"))

    def test_bad_timestamp(self):
        rc, out, err = self.run_cli("--since", "yesterday")
        self.assertEqual(rc, 2)
        self.assertEqual(out, "")
        self.assertIn("--since", err)

    def test_missing_timestamp_value(self):
        rc, _, err = self.run_cli("--until")
        self.assertEqual(rc, 2)
        self.assertIn("--until", err)


if __name__ == "__main__":
    unittest.main()
]==])

