write("logkit/record.py", [==[
from dataclasses import dataclass, field
from datetime import datetime


@dataclass
class Record:
    ts: datetime
    level: str
    component: str
    fields: dict = field(default_factory=dict)
    msg: str = ""
    raw: str = ""
]==])

