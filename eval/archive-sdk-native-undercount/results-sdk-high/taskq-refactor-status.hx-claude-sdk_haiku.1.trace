        self.jobs[job.id] = job
        return job

    def pop_ready(self):
        """Highest priority first, then earliest run_at, then creation order. Counts an attempt."""
        now = self.clock.now()
        ready = [j for j in self.jobs.values() if j.status is Status.QUEUED and j.run_at <= now]
        if not ready:
            return None
        job = min(ready, key=lambda j: (-j.priority, j.run_at, int(j.id.split("-")[1])))
        job.status = Status.RUNNING
        job.attempts += 1
        return job

    def complete(self, job):
        job.status = Status.DONE
        job.error = None

