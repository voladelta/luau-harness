write("taskq/store.py", [==[
import json

from .jobs import Job, Status
from .queue import JobQueue

_FIELDS = ["id", "name", "payload", "priority", "attempts", "max_attempts", "run_at", "status", "error"]


def _encode(job):
    d = {f: getattr(job, f) for f in _FIELDS}
    d["status"] = job.status.value
    return d


def dump(queue):
    return json.dumps({"n": queue._n, "jobs": [_encode(j) for j in queue.jobs.values()]})


def load(clock, text):
    data = json.loads(text)
    q = JobQueue(clock)
    q._n = data["n"]
    for d in data["jobs"]:
        fields = {f: d[f] for f in _FIELDS}
        fields["status"] = Status(fields["status"])
        q.jobs[d["id"]] = Job(**fields)
    return q
]==])

write("tests/test_taskq.py", [==[
import unittest

from taskq.clock import FakeClock
from taskq.jobs import Job, Status
from taskq.queue import JobQueue
from taskq.retry import backoff
from taskq.store import dump, load
from taskq.worker import Worker


class TaskqTests(unittest.TestCase):
    def test_priority_order(self):
        q = JobQueue(FakeClock())
        q.enqueue("a", priority=1)
        hi = q.enqueue("b", priority=5)
        self.assertEqual(q.pop_ready().id, hi.id)

    def test_delay(self):
        c = FakeClock()
        q = JobQueue(c)
        q.enqueue("a", delay=10)
        self.assertIsNone(q.pop_ready())
        c.advance(10)
        self.assertIsNotNone(q.pop_ready())

    def test_worker_and_roundtrip(self):
        c = FakeClock()
        q = JobQueue(c)
        job = q.enqueue("ok", {"x": 1})
        seen = []
        Worker(q, {"ok": seen.append}).run_until_idle()
        self.assertEqual(seen, [{"x": 1}])
        self.assertIs(job.status, Status.DONE)
        self.assertEqual(load(c, dump(q)).stats(), {"done": 1})
        self.assertEqual(backoff(1), 2.0)

    def test_default_status_is_queued(self):
        self.assertIs(Job("job-1", "a", {}).status, Status.QUEUED)

    def test_dump_writes_plain_string_and_load_restores_enum(self):
        c = FakeClock()
        q = JobQueue(c)
        q.enqueue("ok")
        Worker(q, {"ok": lambda p: None}).run_until_idle()
        text = dump(q)
        self.assertIn('"status": "done"', text)
        restored = load(c, text)
        self.assertIs(next(iter(restored.jobs.values())).status, Status.DONE)

    def test_load_accepts_legacy_dump(self):
        legacy = '{"n": 1, "jobs": [{"id": "job-1", "name": "a", "payload": {}, "priority": 0, "attempts": 0, "max_attempts": 3, "run_at": 0.0, "status": "queued", "error": null}]}'
        q = load(FakeClock(), legacy)
        self.assertIs(q.jobs["job-1"].status, Status.QUEUED)


if __name__ == "__main__":
    unittest.main()
]==])

