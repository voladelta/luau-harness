import unittest

from shop.fmt import money
from shop.models import Cart, Item
from shop.orders import place_order
from shop.pricing import subtotal, total


def cart(*items, coupon=None):
    c = Cart(coupon=coupon)
    for it in items:
        c.add(it)
    return c


class ShopTests(unittest.TestCase):
    def test_merge_and_subtotal(self):
        c = cart(Item("a", "A", 250, 2), Item("a", "A", 250, 1))
        self.assertEqual(c.count(), 3)
        self.assertEqual(subtotal(c), 750)

    def test_total_no_coupon(self):
        t = total(cart(Item("a", "A", 1000, 1)), "NY")
        self.assertEqual(t["total"], 1040)

    def test_fiveoff(self):
        t = total(cart(Item("a", "A", 4000, 1), coupon="FIVEOFF"), "OR")
        self.assertEqual((t["discount"], t["total"]), (500, 3500))

    def test_save10_rounds_half_up(self):
        t = total(cart(Item("a", "A", 1005, 1), coupon="SAVE10"), "OR")
        self.assertEqual((t["discount"], t["total"]), (101, 904))

    def test_order_and_money(self):
        o = place_order(cart(Item("a", "A", 100, 1)), "OR")
        self.assertTrue(o["id"].startswith("ORD-"))
        self.assertEqual(money(123450), "$1,234.50")
        self.assertEqual(money(5), "$0.05")


if __name__ == "__main__":
    unittest.main()
]==])

