write("ledger/errors.py", [==[
"""Exception hierarchy for the ledger package.

Every ledger error is a LedgerError and also a ValueError, so existing
``except ValueError`` handlers keep working.
"""


class LedgerError(Exception):
    """Base class for all errors raised by the ledger package."""


class InvalidAmount(LedgerError, ValueError):
    """An amount string could not be parsed."""


class InvalidAccountType(LedgerError, ValueError):
    """An account type is not one of the known types."""


class DuplicateAccount(LedgerError, ValueError):
    """An account with this name already exists in the chart."""


class UnknownAccount(LedgerError, ValueError):
    """An account name is not in the chart."""


class UnbalancedEntry(LedgerError, ValueError):
    """An entry's lines do not sum to zero."""


class ImportRowError(LedgerError, ValueError):
    """A CSV row failed to import.

    ``line`` is the 1-based line number in the CSV text (header is line 1).
    ``cause`` is the original LedgerError.
    """

    def __init__(self, line, cause):
        super().__init__(f"line {line}: {cause}")
        self.line = line
        self.cause = cause
]==])

write("ledger/importer.py", [==[
import csv
import io

from .errors import ImportRowError, LedgerError
from .journal import Entry
from .money import parse_amount


def import_csv(text, journal):
    """Rows: date,memo,debit_account,credit_account,amount. Returns number of entries posted.

    Raises ImportRowError (chained from the original LedgerError) for the first
    row that fails. Rows posted before it remain posted.
    """
    reader = csv.reader(io.StringIO(text))
    header = None
    for fields in reader:  # skip leading blank lines, as csv.DictReader does
        if fields:
            header = fields
            break
    if header is None:
        return 0
    n = 0
    start = reader.line_num + 1  # physical line where the next record begins
    for fields in reader:
        line = start
        start = reader.line_num + 1
        if not fields:  # blank line
            continue
        # Same mapping as csv.DictReader: missing fields become None, extras are ignored.
        row = {name: (fields[i] if i < len(fields) else None) for i, name in enumerate(header)}
        try:
            cents = parse_amount(row["amount"])
            journal.post(Entry(row["date"], row["memo"], [(row["debit_account"], cents), (row["credit_account"], -cents)]))
        except LedgerError as exc:
            raise ImportRowError(line, exc) from exc
        n += 1
    return n
]==])

