q = JobQueue(c)
j = q.enqueue("bad", max_attempts=3)
calls = []
def boom(p):
    calls.append(1)
    raise RuntimeError("x")
w = Worker(q, {"bad": boom})
for _ in range(20):
    c.advance(1000)
    w.run_once()
print("runs:", len(calls), "status:", j.status, "attempts:", j.attempts)
