write("ledger/importer.py", [==[
import csv
import io

from .errors import ImportRowError, LedgerError
from .journal import Entry
from .money import parse_amount


def import_csv(text, journal):
    """Rows: date,memo,debit_account,credit_account,amount. Returns number of entries posted.

    Raises ImportRowError (chaining the original error) on the first failing row.
    Rows before the failing one remain posted.
    """
    n = 0
    reader = csv.DictReader(io.StringIO(text))
    for row in reader:
        try:
            cents = parse_amount(row["amount"])
            journal.post(Entry(row["date"], row["memo"], [(row["debit_account"], cents), (row["credit_account"], -cents)]))
        except LedgerError as exc:
            raise ImportRowError(reader.line_num, exc) from exc
        n += 1
    return n
]==])

write("tests/test_ledger.py", [==[
import unittest

from ledger.accounts import Chart
from ledger.errors import (
    DuplicateAccount,
    ImportRowError,
    InvalidAccountType,
    InvalidAmount,
    LedgerError,
    UnbalancedEntry,
    UnknownAccount,
)
from ledger.importer import import_csv
from ledger.journal import Entry, Journal
from ledger.money import fmt, parse_amount
from ledger.reports import balance_sheet, income_statement

HEADER = "date,memo,debit_account,credit_account,amount\n"


def make():
    c = Chart()
    for n, t in [("cash", "asset"), ("loan", "liability"), ("capital", "equity"), ("sales", "income"), ("rent", "expense")]:
        c.add(n, t)
    return Journal(c)


class LedgerTests(unittest.TestCase):
    def test_money(self):
        self.assertEqual(parse_amount("1,200.5"), 120050)
        self.assertEqual(fmt(-1234), "-12.34")

    def test_bad_amount(self):
        with self.assertRaises(InvalidAmount):
            parse_amount("12.345")

    def test_post_and_reports(self):
        j = make()
        j.post(Entry("2026-01-01", "seed", [("cash", 10000), ("capital", -10000)]))
        j.post(Entry("2026-01-02", "sale", [("cash", 5000), ("sales", -5000)]))
        j.post(Entry("2026-01-03", "rent", [("rent", 2000), ("cash", -2000)]))
        self.assertEqual(balance_sheet(j), {"assets": 13000, "liabilities": 0, "equity": 13000})
        self.assertEqual(income_statement(j, "2026-01-01", "2026-01-31")["net"], 3000)
        with self.assertRaises(UnbalancedEntry):
            j.post(Entry("2026-01-04", "bad", [("cash", 1)]))

    def test_unknown_account(self):
        j = make()
        with self.assertRaises(UnknownAccount):
            j.post(Entry("2026-01-04", "ghost", [("nope", 100), ("cash", -100)]))
        with self.assertRaises(UnknownAccount):
            j.chart.type_of("nope")

    def test_chart_errors(self):
        c = make()
        with self.assertRaises(DuplicateAccount):
            c.add("cash", "asset")
        with self.assertRaises(InvalidAccountType):
            c.add("misc", "bogus")

    def test_error_hierarchy(self):
        for cls in (InvalidAmount, InvalidAccountType, DuplicateAccount, UnknownAccount, UnbalancedEntry, ImportRowError):
            self.assertTrue(issubclass(cls, LedgerError))
            self.assertTrue(issubclass(cls, ValueError))
        with self.assertRaises(ValueError):
            make().post(Entry("2026-01-04", "bad", [("cash", 1)]))

    def test_import(self):
        j = make()
        n = import_csv(HEADER + "2026-01-02,sale,cash,sales,12.50\n", j)
        self.assertEqual((n, j.balance("cash")), (1, 1250))

    def test_import_row_error(self):
        j = make()
        text = HEADER + "2026-01-02,sale,cash,sales,12.50\n2026-01-03,oops,cash,sales,abc\n2026-01-04,late,cash,sales,1.00\n"
        with self.assertRaises(ImportRowError) as ctx:
            import_csv(text, j)
        err = ctx.exception
        self.assertEqual(err.line, 3)
        self.assertIsInstance(err.cause, InvalidAmount)
        self.assertIs(err.__cause__, err.cause)
        self.assertEqual(str(err), f"line 3: {err.cause}")
        self.assertEqual(j.balance("cash"), 1250)
        self.assertEqual(len(j.entries), 1)

    def test_import_row_error_unknown_account(self):
        j = make()
        text = HEADER + "2026-01-02,sale,ghost,sales,1.00\n"
        with self.assertRaises(ImportRowError) as ctx:
            import_csv(text, j)
        self.assertEqual(ctx.exception.line, 2)
        self.assertIsInstance(ctx.exception.cause, UnknownAccount)


if __name__ == "__main__":
    unittest.main()
]==])

