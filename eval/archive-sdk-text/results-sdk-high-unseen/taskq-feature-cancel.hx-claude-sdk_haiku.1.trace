    def test_cancel_queued_job(self):
        c = FakeClock()
        q = JobQueue(c)
        j = q.enqueue("a")
        c.advance(5)
        self.assertIs(q.cancel(j.id), j)
        self.assertEqual(j.status, "cancelled")
        self.assertEqual(j.cancelled_at, 5.0)
        self.assertIsNone(q.pop_ready())
        self.assertEqual(q.stats(), {"cancelled": 1})

    def test_cancel_idempotent_and_guards(self):
        c = FakeClock()
        q = JobQueue(c)
        j = q.enqueue("a")
        q.cancel(j.id)
        c.advance(3)
        self.assertIs(q.cancel(j.id), j)
        self.assertEqual(j.cancelled_at, 0.0)
        r = q.enqueue("b")
        q.pop_ready()  # r is now running
        with self.assertRaises(ValueError):
            q.cancel(r.id)
        with self.assertRaises(KeyError):
            q.cancel("job-99")

    def test_cancelled_job_is_not_retried(self):
        c = FakeClock()
        q = JobQueue(c)
        j = q.enqueue("a")
        q.pop_ready()
        q.fail(j, "boom")  # scheduled for retry
        q.cancel(j.id)
        c.advance(100)
        self.assertIsNone(q.pop_ready())
        self.assertEqual(j.status, "cancelled")

    def test_cancelled_at_roundtrip_and_old_dump(self):
        c = FakeClock()
        q = JobQueue(c)
        j = q.enqueue("a")
        c.advance(7)
        q.cancel(j.id)
        q2 = load(c, dump(q))
        self.assertEqual(q2.jobs[j.id].cancelled_at, 7.0)
        self.assertEqual(q2.jobs[j.id].status, "cancelled")
        old = json.dumps({"n": 1, "jobs": [{"id": "job-1", "name": "a", "payload": {}, "priority": 0,
                          "attempts": 0, "max_attempts": 3, "run_at": 0.0, "status": "queued", "error": None}]})
        self.assertIsNone(load(c, old).jobs["job-1"].cancelled_at)]==]))

