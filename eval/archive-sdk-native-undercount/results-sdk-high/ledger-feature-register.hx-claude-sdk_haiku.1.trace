def register(journal, account, start=None, end=None):
    """Chronological account register. Balance runs over all entries; rows are limited to start <= date <= end (None = unbounded)."""
    rows = []
    balance = 0
    # sorted() is stable, so entries with equal dates keep posting order
    for e, cents in sorted(journal.entries_for(account), key=lambda p: p[0].date):
        balance += cents
        if (start is None or e.date >= start) and (end is None or e.date <= end):
            rows.append({"date": e.date, "memo": e.memo, "amount": cents, "balance": balance})
    return rows


def format_register(rows):
    return "\n".join(
        f"{r['date']}  {r['memo']:<20}  {fmt(r['amount']):>12}  {fmt(r['balance']):>12}" for r in rows
    )]==]))

