class CliTests(unittest.TestCase):
    def run_cli(self, *args):
        import contextlib, io, os, tempfile
        from logkit.cli import main
        with tempfile.TemporaryDirectory() as d:
            p = os.path.join(d, "l.log")
            with open(p, "w") as f:
                f.write(LINE + "\n2026-01-05T10:00:09Z ERROR db ms=900 boom\n")
            out, err = io.StringIO(), io.StringIO()
            with contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                code = main([p, *args])
        return code, out.getvalue(), err.getvalue()

    def test_json_and_range(self):
        import json
        from logkit.render import json_line
        code, out, _ = self.run_cli("--json", "--since", "2026-01-05T10:00:04Z")
        self.assertEqual(code, 0)
        d = json.loads(out)
        self.assertEqual(list(d), ["ts", "level", "component", "fields", "msg"])
        self.assertEqual(d["ts"], "2026-01-05T10:00:09Z")
        self.assertEqual(out.strip(), json_line(parse_line("2026-01-05T10:00:09Z ERROR db ms=900 boom")))
        _, out, _ = self.run_cli("--until", "2026-01-05T10:00:09Z")
        self.assertEqual(len(out.splitlines()), 1)

    def test_bad_ts(self):
        code, _, err = self.run_cli("--since", "nope")
        self.assertEqual(code, 2)
        self.assertTrue(err)


