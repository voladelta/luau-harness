=== wiki/blocks.py ===
import re

_HEADING = re.compile(r"^(#{1,6})\s+(.*\S)\s*$")


def parse(text):
    """Split markdown-lite into blocks:
    ("heading", level, text) | ("para", text) | ("list", [items]) | ("code", text)
    """
    blocks, para, items, code = [], [], [], None

    def flush():
        nonlocal para, items
        if para:
            blocks.append(("para", " ".join(para)))
            para = []
        if items:
            blocks.append(("list", items))
            items = []

    for line in text.split("\n"):
        if code is not None:
            if line.strip() == "```":
                blocks.append(("code", "\n".join(code)))
                code = None
            else:
                code.append(line)
            continue
        if line.strip() == "```":
            flush()
            code = []
            continue
        m = _HEADING.match(line)
        if m:
            flush()
            blocks.append(("heading", len(m.group(1)), m.group(2)))
        elif line.startswith("- "):
            if para:
                flush()
            items.append(line[2:].strip())
        elif not line.strip():
            flush()
        else:
            if items:
                flush()
            para.append(line.strip())
    flush()
    if code is not None:
        blocks.append(("code", "\n".join(code)))
    return blocks

=== wiki/html.py ===
import html as _html

from . import inline
from .toc import slug


def render(blocks):
    out = []
    for b in blocks:
        kind = b[0]
        if kind == "heading":
            out.append(f'<h{b[1]} id="{slug(b[2])}">{inline.render(b[2])}</h{b[1]}>')
        elif kind == "para":
            out.append(f"<p>{inline.render(b[1])}</p>")
        elif kind == "list":
            out.append("<ul>" + "".join(f"<li>{inline.render(i)}</li>" for i in b[1]) + "</ul>")
        elif kind == "code":
            out.append(f"<pre><code>{_html.escape(b[1], quote=False)}</code></pre>")
        else:
            raise ValueError(f"unknown block: {kind}")
    return "\n".join(out)

=== wiki/toc.py ===
import re


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def build(blocks):
    """[(level, text, slug)] for every heading block, in order."""
    return [(b[1], b[2], slug(b[2])) for b in blocks if b[0] == "heading"]

=== wiki/convert.py ===
from . import blocks, html


def convert(text):
    return html.render(blocks.parse(text))

=== wiki/inline.py ===
import html
import re

_CODE = re.compile(r"`([^`]+)`")
_BOLD = re.compile(r"\*\*(.+?)\*\*")
_EM = re.compile(r"\*(.+?)\*")
_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def render(text):
    """Inline markup -> HTML. Code spans are protected from further formatting."""
    text = html.escape(text, quote=False)
    spans = []

    def stash(m):
        spans.append(f"<code>{m.group(1)}</code>")
        return f"\x00{len(spans) - 1}\x00"

    text = _CODE.sub(stash, text)
    text = _BOLD.sub(r"<strong>\1</strong>", text)
    text = _EM.sub(r"<em>\1</em>", text)
    text = _LINK.sub(r'<a href="\2">\1</a>', text)
    return re.sub(r"\x00(\d+)\x00", lambda m: spans[int(m.group(1))], text)

=== wiki/links.py ===
import re

_LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")


def extract(text):
    """[(label, url)] in document order."""
    return _LINK.findall(text)

=== tests/test_wiki.py ===
import unittest

from wiki.convert import convert
from wiki.links import extract
from wiki.toc import build, slug
from wiki import blocks


class WikiTests(unittest.TestCase):
    def test_convert(self):
        out = convert("# Hi There\n\nsome *em* and `x*y*` text\n\n- a\n- b\n")
        self.assertIn('<h1 id="hi-there">Hi There</h1>', out)
        self.assertIn("<em>em</em>", out)
        self.assertIn("<code>x*y*</code>", out)
        self.assertIn("<ul><li>a</li><li>b</li></ul>", out)

    def test_code_and_links(self):
        self.assertIn("<pre><code>a &lt; b</code></pre>", convert("```\na < b\n```"))
        self.assertEqual(extract("see [x](http://a) and [y](b)"), [("x", "http://a"), ("y", "b")])

    def test_toc(self):
        self.assertEqual(build(blocks.parse("# A\n## B c")), [(1, "A", "a"), (2, "B c", "b-c")])
        self.assertEqual(slug("Hello, World!"), "hello-world")


if __name__ == "__main__":
    unittest.main()

