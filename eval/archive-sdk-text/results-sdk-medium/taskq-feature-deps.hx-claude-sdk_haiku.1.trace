    def test_depends_on_blocks_until_done(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a")
        b = q.enqueue("b", depends_on=[a.id])
        self.assertIs(q.pop_ready(), a)
        self.assertIsNone(q.pop_ready())
        q.complete(a)
        self.assertIs(q.pop_ready(), b)

    def test_unknown_dependency_raises(self):
        q = JobQueue(FakeClock())
        with self.assertRaises(ValueError) as cm:
            q.enqueue("a", depends_on=["job-99"])
        self.assertEqual(str(cm.exception), "unknown dependency: job-99")

    def test_dead_propagates_to_transitive_dependents(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a", max_attempts=1)
        b = q.enqueue("b", depends_on=[a.id])
        c = q.enqueue("c", depends_on=[b.id])
        d = q.enqueue("d")
        self.assertIs(q.pop_ready(), a)
        q.fail(a, "boom")
        self.assertEqual(a.status, "dead")
        for j in (b, c):
            self.assertEqual(j.status, "dead")
            self.assertEqual(j.error, f"dependency failed: {a.id}")
            self.assertEqual(j.attempts, 0)
        self.assertEqual(d.status, "queued")

    def test_retrying_dependency_does_not_kill_dependents(self):
        q = JobQueue(FakeClock())
        a = q.enqueue("a")
        b = q.enqueue("b", depends_on=[a.id])
        q.pop_ready()
        q.fail(a, "flaky")
        self.assertEqual(a.status, "queued")
        self.assertEqual(b.status, "queued")

    def test_depends_on_roundtrip_and_legacy_dump(self):
        c = FakeClock()
        q = JobQueue(c)
        a = q.enqueue("a")
        q.enqueue("b", depends_on=[a.id])
        loaded = load(c, dump(q))
        self.assertEqual(loaded.jobs["job-2"].depends_on, [a.id])
        legacy = json.dumps({"n": 1, "jobs": [{
            "id": "job-1", "name": "a", "payload": {}, "priority": 0, "attempts": 0,
            "max_attempts": 3, "run_at": 0.0, "status": "queued", "error": None}]})
        self.assertEqual(load(c, legacy).jobs["job-1"].depends_on, [])
]==]))

